<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:um="clr-namespace:SupportToolApp.Pages.UserManager"
       xmlns:em="clr-namespace:SupportToolApp.Pages.Email"
       xmlns:sp="clr-namespace:SupportToolApp.Pages.Spam"
       xmlns:ra="clr-namespace:SupportToolApp.Pages.RemoteAccess"
       xmlns:rp="clr-namespace:SupportToolApp.Pages.Reporting"
       xmlns:si="clr-namespace:SupportToolApp.Pages.SystemInfo"
       xmlns:sc="clr-namespace:SupportToolApp.Pages.Search"
       xmlns:st="clr-namespace:SupportToolApp.Pages.Settings"
       xmlns:tl="clr-namespace:SupportToolApp.Pages.Tools"
       xmlns:cr="clr-namespace:SupportToolApp.Pages.Credentials"
       xmlns:hp="clr-namespace:SupportToolApp.Pages.Help"
       xmlns:cp="clr-namespace:SupportToolApp.Pages.Compare"
       xmlns:nm="clr-namespace:SupportToolApp.Pages.Monitor"
       xmlns:snd="clr-namespace:SupportToolApp.Pages.SoundCombine"
       xmlns:wa="clr-namespace:SupportToolApp.Pages.WebApps"
       x:Class="SupportToolApp.AppShell"
       Shell.FlyoutBehavior="Flyout"
       Title="IT Support Tool">

    <Shell.MenuBarItems>
        <MenuBarItem Text="File">
            <MenuFlyoutItem Text="Save Config..." Clicked="OnSaveConfig"/>
            <MenuFlyoutItem Text="Load Config..." Clicked="OnLoadConfig"/>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="⚙️ Settings" Clicked="OnSettingsClicked"/>
            <MenuFlyoutItem Text="🔑 Credentials" Clicked="OnCredentialsClicked"/>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="Help" Clicked="OnHelpClicked"/>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="Exit" Clicked="OnExitClicked"/>
        </MenuBarItem>
    </Shell.MenuBarItems>

    <Shell.TitleView>
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Fill">
            <!-- Logo badge: image if configured, else initials tile -->
            <Border x:Name="LogoBadge" Grid.Column="0"
                    StrokeShape="RoundRectangle 8" Stroke="Transparent"
                    BackgroundColor="#0078D4"
                    WidthRequest="120" HeightRequest="72"
                    VerticalOptions="Center">
                <Grid>
                    <Image x:Name="LogoImage" IsVisible="False"
                           Aspect="AspectFit" WidthRequest="120" HeightRequest="72"/>
                    <Label x:Name="LogoInitialsLabel" Text="IT"
                           FontSize="22" FontAttributes="Bold" TextColor="White"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Grid>
            </Border>
        <ScrollView Grid.Column="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" VerticalOptions="Center">
            <HorizontalStackLayout Spacing="4" Padding="0,2">
                <Button x:Name="BtnFolder" Text="Folder" Clicked="OnFolderClicked"
                        BackgroundColor="#D4500A" Padding="14,6" FontSize="12" FontAttributes="Bold"
                        IsVisible="False" TextColor="White"/>
                <Button x:Name="BtnLibrary" Text="Library" Clicked="OnLibraryClicked"
                        BackgroundColor="#7B2FBE" Padding="14,6" FontSize="12" FontAttributes="Bold" TextColor="White"/>
                <Button x:Name="BtnO365" Text="Office 365" Clicked="OnO365Clicked"
                        BackgroundColor="#0078D4" Padding="14,6" FontSize="12" FontAttributes="Bold" TextColor="White"/>
                <Button x:Name="BtnGoogle" Text="Google" Clicked="OnGoogleClicked"
                        BackgroundColor="#4285F4" Padding="14,6" FontSize="12" FontAttributes="Bold" TextColor="White"/>
                <Button x:Name="BtnQuickLink1" Clicked="OnQuickLink1Clicked"
                        BackgroundColor="#228B22" Padding="14,6" FontSize="12" FontAttributes="Bold"
                        IsVisible="False" TextColor="White"/>
                <Button x:Name="BtnQuickLink2" Clicked="OnQuickLink2Clicked"
                        BackgroundColor="#228B22" Padding="14,6" FontSize="12" FontAttributes="Bold"
                        IsVisible="False" TextColor="White"/>
                <Button x:Name="BtnQuickLink3" Clicked="OnQuickLink3Clicked"
                        BackgroundColor="#228B22" Padding="14,6" FontSize="12" FontAttributes="Bold"
                        IsVisible="False" TextColor="White"/>
                <Button x:Name="BtnQuickLink4" Clicked="OnQuickLink4Clicked"
                        BackgroundColor="#228B22" Padding="14,6" FontSize="12" FontAttributes="Bold"
                        IsVisible="False" TextColor="White"/>
                <!-- LO placeholder — reserved for future Local Only feature -->
                <Button Text="LO" IsEnabled="False" BackgroundColor="#555" TextColor="#888"
                        Padding="14,6" FontSize="12" FontAttributes="Bold"/>
            </HorizontalStackLayout>
        </ScrollView>
        </Grid>
    </Shell.TitleView>

    <Shell.FlyoutHeader>
        <VerticalStackLayout BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}" Padding="16,32,16,16">
            <Label Text="IT Support Tool" FontSize="18" FontAttributes="Bold" TextColor="White"/>
            <Label Text="Steven Powell" FontSize="12" TextColor="#CCFFFFFF"/>
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <Shell.FlyoutFooter>
        <Label Text="Developed by Steven Powell  ·  2026"
               FontSize="10" TextColor="#44FFFFFF"
               HorizontalTextAlignment="Center"
               Padding="0,8"/>
    </Shell.FlyoutFooter>

    <FlyoutItem Title="User Manager">
        <ShellContent ContentTemplate="{DataTemplate um:UserManagerPage}" Route="UserManager"/>
    </FlyoutItem>

    <FlyoutItem Title="Email &amp; Mailbox">
        <ShellContent ContentTemplate="{DataTemplate em:EmailPage}" Route="Email"/>
    </FlyoutItem>

    <FlyoutItem Title="Spam / Breach Response">
        <ShellContent ContentTemplate="{DataTemplate sp:SpamPage}" Route="Spam"/>
    </FlyoutItem>

    <FlyoutItem Title="Tools">
        <ShellContent ContentTemplate="{DataTemplate tl:ToolsPage}" Route="Tools"/>
    </FlyoutItem>

    <FlyoutItem Title="Remote Access">
        <ShellContent ContentTemplate="{DataTemplate ra:RemoteAccessPage}" Route="RemoteAccess"/>
    </FlyoutItem>

    <FlyoutItem Title="Reporting">
        <ShellContent ContentTemplate="{DataTemplate rp:ReportingPage}" Route="Reporting"/>
    </FlyoutItem>

    <FlyoutItem Title="System Info">
        <ShellContent ContentTemplate="{DataTemplate si:SystemInfoPage}" Route="SystemInfo"/>
    </FlyoutItem>

    <FlyoutItem Title="Web Apps">
        <ShellContent ContentTemplate="{DataTemplate wa:WebAppsPage}" Route="WebApps"/>
    </FlyoutItem>

    <MenuItem Text="Settings"     Clicked="OnSettingsClicked"/>
    <MenuItem Text="Credentials"  Clicked="OnCredentialsClicked"/>
    <MenuItem Text="Help"         Clicked="OnHelpClicked"/>

</Shell>
