<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SupportToolApp.Pages.Settings.SettingsPage"
             Title="Settings">
    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="16">
            <Label Text="Configuration" FontSize="20" FontAttributes="Bold"/>
            <Label Text="All settings are stored locally and never sent anywhere." TextColor="Gray" FontSize="12"/>

            <!-- Microsoft 365 Authentication -->
            <Border Stroke="LightGray" StrokeThickness="1" Padding="12" StrokeShape="RoundRectangle 6">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Microsoft 365 Authentication" FontAttributes="Bold" FontSize="15"/>

                    <!-- Status indicator -->
                    <Border Padding="10,8" StrokeThickness="0" StrokeShape="RoundRectangle 6"
                            BackgroundColor="#F5F5F5">
                        <Grid ColumnDefinitions="12,*" ColumnSpacing="10">
                            <Ellipse Grid.Column="0" WidthRequest="10" HeightRequest="10"
                                     VerticalOptions="Center"
                                     Fill="{Binding AuthStatusColor}"/>
                            <Label Grid.Column="1" Text="{Binding AuthStatusText}"
                                   VerticalOptions="Center" FontSize="13"/>
                        </Grid>
                    </Border>

                    <!-- Sign in hint -->
                    <Label Text="Fill in Tenant ID and Client ID below, then sign in. The browser will open for interactive login."
                           TextColor="Gray" FontSize="12" IsVisible="{Binding IsNotSignedIn}"/>

                    <!-- Buttons -->
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Sign In to Microsoft 365"
                                Command="{Binding SignInCommand}"
                                IsEnabled="{Binding CanSignIn}"
                                IsVisible="{Binding IsNotSignedIn}"
                                BackgroundColor="#0078D4"/>
                        <ActivityIndicator IsRunning="{Binding IsSigningIn}"
                                          IsVisible="{Binding IsSigningIn}"
                                          Color="#0078D4"
                                          VerticalOptions="Center"/>
                        <Button Text="Sign Out"
                                Command="{Binding SignOutCommand}"
                                IsEnabled="{Binding CanSignOut}"
                                IsVisible="{Binding IsSignedIn}"
                                BackgroundColor="#CC4400"/>
                    </HorizontalStackLayout>

                    <Label Text="Note: Sign-in is only needed when using live Microsoft Graph data (mock mode off)."
                           TextColor="Gray" FontSize="11" FontAttributes="Italic"/>
                </VerticalStackLayout>
            </Border>

            <!-- Domain / Graph Config -->
            <Border Stroke="LightGray" StrokeThickness="1" Padding="12" StrokeShape="RoundRectangle 6">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Domain &amp; Graph Settings" FontAttributes="Bold" FontSize="15"/>
                    <Label Text="Domain (e.g. contoso.com)" TextColor="Gray" FontSize="12"/>
                    <Entry Text="{Binding Domain}" Placeholder="contoso.com"/>
                    <Label Text="Tenant ID" TextColor="Gray" FontSize="12"/>
                    <Entry Text="{Binding TenantId}" Placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"/>
                    <Label Text="Client ID (App Registration)" TextColor="Gray" FontSize="12"/>
                    <Entry Text="{Binding ClientId}" Placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"/>
                    <Label Text="Admin UPN" TextColor="Gray" FontSize="12"/>
                    <Entry Text="{Binding AdminUpn}" Placeholder="admin@contoso.com"/>
                    <Border Padding="8,6" BackgroundColor="#FFF8E1" StrokeThickness="0" StrokeShape="RoundRectangle 4">
                        <Label FontSize="11" TextColor="#795548">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="App registration needs these API permissions: " FontAttributes="Bold"/>
                                    <Span Text="User.ReadWrite.All, Directory.ReadWrite.All, Mail.ReadWrite, MailboxSettings.ReadWrite"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Tool Paths -->
            <Border Stroke="LightGray" StrokeThickness="1" Padding="12" StrokeShape="RoundRectangle 6">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Tool Paths" FontAttributes="Bold" FontSize="15"/>
                    <Label Text="TeamViewer Executable" TextColor="Gray" FontSize="12"/>
                    <Entry Text="{Binding TeamViewerPath}" Placeholder="C:\Program Files\TeamViewer\TeamViewer.exe"/>
                    <Label Text="SCCM Console Executable" TextColor="Gray" FontSize="12"/>
                    <Entry Text="{Binding SccmConsolePath}" Placeholder="C:\Program Files\...\Microsoft.ConfigurationManagement.exe"/>
                </VerticalStackLayout>
            </Border>

            <!-- Servers -->
            <Border Stroke="LightGray" StrokeThickness="1" Padding="12" StrokeShape="RoundRectangle 6">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Servers" FontAttributes="Bold" FontSize="15"/>
                    <CollectionView ItemsSource="{Binding Servers}" HeightRequest="150">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,*,Auto" Padding="4,4" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="{Binding Host}" TextColor="Gray" VerticalOptions="Center"/>
                                    <Button Grid.Column="2" Text="Remove"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveServerCommand}"
                                            CommandParameter="{Binding .}"
                                            FontSize="11" Padding="8,4" BackgroundColor="OrangeRed"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Button Text="+ Add Server" Command="{Binding AddServerCommand}"
                            HorizontalOptions="Start" FontSize="13" Padding="12,6"
                            BackgroundColor="#228B22"/>
                </VerticalStackLayout>
            </Border>

            <!-- Data Source Toggle -->
            <Border Stroke="LightGray" StrokeThickness="1" Padding="12" StrokeShape="RoundRectangle 6">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Data Source" FontAttributes="Bold" FontSize="15"/>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Switch Grid.Column="0" IsToggled="{Binding UseMockData}"/>
                        <Label Grid.Column="1" Text="Use simulated (mock) data — no live Microsoft 365 required"
                               VerticalOptions="Center"/>
                    </Grid>
                    <!-- Restart banner -->
                    <Border Padding="10,8" BackgroundColor="#FFF3E0" StrokeShape="RoundRectangle 4"
                            Stroke="#FFB74D" IsVisible="{Binding RestartRequired}">
                        <Label Text="⚠ Restart the app after saving to apply the data source change."
                               TextColor="#E65100" FontSize="12"/>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Save + Status -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Grid.Column="0" Text="Save Settings" Command="{Binding SaveCommand}"
                        BackgroundColor="ForestGreen" Padding="20,10"/>
                <Border Grid.Column="1" Padding="12,8" BackgroundColor="#E8F5E9"
                        StrokeShape="RoundRectangle 6" Stroke="#A5D6A7"
                        IsVisible="{Binding HasStatus}" VerticalOptions="Center">
                    <Label Text="{Binding StatusMessage}" TextColor="#2E7D32" FontSize="13"/>
                </Border>
            </Grid>

            <BoxView HeightRequest="20"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
