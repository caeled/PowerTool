<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SupportToolApp.Pages.Settings.SettingsPage"
             Title="Settings">
    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="16">
            <Label Text="Configuration" FontSize="20" FontAttributes="Bold"/>
            <Label Text="All settings are stored locally and never sent anywhere." TextColor="Gray" FontSize="12"/>

            <!-- Microsoft 365 Authentication -->
            <Border Stroke="LightGray" StrokeThickness="1" Padding="12" StrokeShape="RoundRectangle 6">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Microsoft 365 Authentication" FontAttributes="Bold" FontSize="15"/>

                    <!-- Status indicator -->
                    <Border Padding="10,8" StrokeThickness="0" StrokeShape="RoundRectangle 6"
                            BackgroundColor="#F5F5F5">
                        <Grid ColumnDefinitions="12,*" ColumnSpacing="10">
                            <Ellipse Grid.Column="0" WidthRequest="10" HeightRequest="10"
                                     VerticalOptions="Center"
                                     Fill="{Binding AuthStatusColor}"/>
                            <Label Grid.Column="1" Text="{Binding AuthStatusText}"
                                   VerticalOptions="Center" FontSize="13"/>
                        </Grid>
                    </Border>

                    <!-- Sign in hint -->
                    <Label Text="Fill in Tenant ID and Client ID below, then sign in. The browser will open for interactive login."
                           TextColor="Gray" FontSize="12" IsVisible="{Binding IsNotSignedIn}"/>

                    <!-- Buttons -->
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Sign In to Microsoft 365"
                                Command="{Binding SignInCommand}"
                                IsEnabled="{Binding CanSignIn}"
                                IsVisible="{Binding IsNotSignedIn}"
                                BackgroundColor="#0078D4"/>
                        <ActivityIndicator IsRunning="{Binding IsSigningIn}"
                                          IsVisible="{Binding IsSigningIn}"
                                          Color="#0078D4"
                                          VerticalOptions="Center"/>
                        <Button Text="Sign Out"
                                Command="{Binding SignOutCommand}"
                                IsEnabled="{Binding CanSignOut}"
                                IsVisible="{Binding IsSignedIn}"
                                BackgroundColor="#CC4400"/>
                    </HorizontalStackLayout>

                    <Label Text="Note: Sign-in is only needed when using live Microsoft Graph data (mock mode off)."
                           TextColor="Gray" FontSize="11" FontAttributes="Italic"/>
                </VerticalStackLayout>
            </Border>

            <!-- Domain / Graph Config -->
            <Border Stroke="LightGray" StrokeThickness="1" Padding="12" StrokeShape="RoundRectangle 6">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Domain &amp; Graph Settings" FontAttributes="Bold" FontSize="15"/>
                    <Label Text="Domain (e.g. contoso.com)" TextColor="Gray" FontSize="12"/>
                    <Entry Text="{Binding Domain}" Placeholder="contoso.com"/>
                    <Label Text="Tenant ID" TextColor="Gray" FontSize="12"/>
                    <Entry Text="{Binding TenantId}" Placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"/>
                    <Label Text="Client ID (App Registration)" TextColor="Gray" FontSize="12"/>
                    <Entry Text="{Binding ClientId}" Placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"/>
                    <Label Text="Admin UPN" TextColor="Gray" FontSize="12"/>
                    <Entry Text="{Binding AdminUpn}" Placeholder="admin@contoso.com"/>
                    <Border Padding="8,6" BackgroundColor="#FFF8E1" StrokeThickness="0" StrokeShape="RoundRectangle 4">
                        <Label FontSize="11" TextColor="#795548">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="App registration needs these API permissions: " FontAttributes="Bold"/>
                                    <Span Text="User.ReadWrite.All, Directory.ReadWrite.All, Mail.ReadWrite, MailboxSettings.ReadWrite"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Tool Paths -->
            <Border Stroke="LightGray" StrokeThickness="1" Padding="12" StrokeShape="RoundRectangle 6">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Tool Paths" FontAttributes="Bold" FontSize="15"/>
                    <Label Text="TeamViewer Executable" TextColor="Gray" FontSize="12"/>
                    <Entry Text="{Binding TeamViewerPath}" Placeholder="C:\Program Files\TeamViewer\TeamViewer.exe"/>
                    <Label Text="SCCM Console (legacy)" TextColor="Gray" FontSize="12"/>
                    <Entry Text="{Binding SccmConsolePath}" Placeholder="C:\Program Files\...\Microsoft.ConfigurationManagement.exe"/>
                </VerticalStackLayout>
            </Border>

            <!-- Deployment Tool Button -->
            <Border Stroke="#7B2FBE" StrokeThickness="1" Padding="12" StrokeShape="RoundRectangle 6" BackgroundColor="#F8F0FF">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Deployment Tool Button" FontAttributes="Bold" FontSize="15" TextColor="#7B2FBE"/>
                    <Label Text="Configures the button on Remote Access. Set a label and a URL (Syxsense, Ninja, etc.) or exe path."
                           TextColor="Gray" FontSize="12" LineBreakMode="WordWrap"/>
                    <Grid ColumnDefinitions="80,*" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Label:" VerticalOptions="Center"/>
                        <Entry Grid.Column="1" Text="{Binding DeployToolName}" Placeholder="Syxsense"/>
                    </Grid>
                    <Grid ColumnDefinitions="80,*" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="URL / Path:" VerticalOptions="Center"/>
                        <Entry Grid.Column="1" Text="{Binding DeployToolUrl}" Placeholder="https://app.syxsense.com  or  C:\tool.exe"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Preconfigured Servers -->
            <Border Stroke="#0078D4" StrokeThickness="1" Padding="12" StrokeShape="RoundRectangle 6" BackgroundColor="#F0F7FF">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Preconfigured Servers" FontAttributes="Bold" FontSize="15" TextColor="#0078D4"/>
                    <Label Text="Shown in the Remote Access server list. Click a server there to auto-fill the target."
                           TextColor="Gray" FontSize="12"/>
                    <CollectionView x:Name="ServerListView" ItemsSource="{Binding Servers}" HeightRequest="150">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,*,Auto" Padding="4,4" ColumnSpacing="8">
                                    <Entry Grid.Column="0" Text="{Binding Name}" FontSize="12"/>
                                    <Entry Grid.Column="1" Text="{Binding Host}" FontSize="12"/>
                                    <Button Grid.Column="2" Text="✕" Padding="8,4" FontSize="11"
                                            BackgroundColor="#C62828" TextColor="White"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveServerCommand}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                        <Entry Grid.Column="0" Text="{Binding NewServerName}" Placeholder="Name (e.g. File Server 1)" FontSize="12"/>
                        <Entry Grid.Column="1" Text="{Binding NewServerHost}" Placeholder="Host (e.g. fs01.corp.com)" FontSize="12"/>
                        <Button Grid.Column="2" Text="Add" Padding="12,6"
                                BackgroundColor="#0078D4" TextColor="White"
                                Command="{Binding AddServerCommand}"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Quick Launch Buttons -->
            <Border Stroke="#228B22" StrokeThickness="1" Padding="12" StrokeShape="RoundRectangle 6" BackgroundColor="#F0FFF4">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Quick Launch Buttons" FontAttributes="Bold" FontSize="15" TextColor="#228B22"/>
                    <Label Text="Four configurable buttons in the toolbar. Enter a label and any URL."
                           TextColor="Gray" FontSize="12"/>
                    <Grid ColumnDefinitions="60,*,60,*" ColumnSpacing="6">
                        <Label Grid.Column="0" Text="Button 1:" VerticalOptions="Center" FontAttributes="Bold"/>
                        <Entry Grid.Column="1" Text="{Binding Ql1Name}" Placeholder="Label"/>
                        <Label Grid.Column="2" Text="URL:" VerticalOptions="Center"/>
                        <Entry Grid.Column="3" Text="{Binding Ql1Url}" Placeholder="https://..."/>
                    </Grid>
                    <Grid ColumnDefinitions="60,*,60,*" ColumnSpacing="6">
                        <Label Grid.Column="0" Text="Button 2:" VerticalOptions="Center" FontAttributes="Bold"/>
                        <Entry Grid.Column="1" Text="{Binding Ql2Name}" Placeholder="Label"/>
                        <Label Grid.Column="2" Text="URL:" VerticalOptions="Center"/>
                        <Entry Grid.Column="3" Text="{Binding Ql2Url}" Placeholder="https://..."/>
                    </Grid>
                    <Grid ColumnDefinitions="60,*,60,*" ColumnSpacing="6">
                        <Label Grid.Column="0" Text="Button 3:" VerticalOptions="Center" FontAttributes="Bold"/>
                        <Entry Grid.Column="1" Text="{Binding Ql3Name}" Placeholder="Label"/>
                        <Label Grid.Column="2" Text="URL:" VerticalOptions="Center"/>
                        <Entry Grid.Column="3" Text="{Binding Ql3Url}" Placeholder="https://..."/>
                    </Grid>
                    <Grid ColumnDefinitions="60,*,60,*" ColumnSpacing="6">
                        <Label Grid.Column="0" Text="Button 4:" VerticalOptions="Center" FontAttributes="Bold"/>
                        <Entry Grid.Column="1" Text="{Binding Ql4Name}" Placeholder="Label"/>
                        <Label Grid.Column="2" Text="URL:" VerticalOptions="Center"/>
                        <Entry Grid.Column="3" Text="{Binding Ql4Url}" Placeholder="https://..."/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Folder & Library -->
            <Border Stroke="#D4500A" StrokeThickness="1" Padding="12" StrokeShape="RoundRectangle 6" BackgroundColor="#FFF8F0">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Folder &amp; Library Buttons" FontAttributes="Bold" FontSize="15" TextColor="#D4500A"/>
                    <Label Text="Folder: opens a local folder in Explorer. Library: opens a reference URL."
                           TextColor="Gray" FontSize="12"/>
                    <Grid ColumnDefinitions="60,100,*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Folder:" VerticalOptions="Center" FontAttributes="Bold"/>
                        <Entry Grid.Column="1" Text="{Binding FolderName}" Placeholder="Button name"/>
                        <Entry Grid.Column="2" Text="{Binding LocalFolder}" Placeholder="C:\path\to\folder"/>
                        <Button Grid.Column="3" Text="Browse" Command="{Binding BrowseFolderCommand}"
                                BackgroundColor="#D4500A" TextColor="White" Padding="12,6"/>
                    </Grid>
                    <Grid ColumnDefinitions="60,100,*" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Library:" VerticalOptions="Center" FontAttributes="Bold"/>
                        <Entry Grid.Column="1" Text="{Binding LibraryName}" Placeholder="Button name"/>
                        <Entry Grid.Column="2" Text="{Binding LibraryUrl}" Placeholder="https://en.wikipedia.org/wiki/Main_Page"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Relay Service (non-Windows platforms) -->
            <Border Stroke="#0078D4" StrokeThickness="1" Padding="12" StrokeShape="RoundRectangle 6" BackgroundColor="#EEF4FF">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Relay Service" FontAttributes="Bold" FontSize="15" TextColor="#0078D4"/>
                    <Label Text="Required on macOS / Linux / Android. Install the PowellTec Relay service on one Windows machine on your network."
                           TextColor="Gray" FontSize="12"/>
                    <Grid ColumnDefinitions="80,*" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Relay URL:" VerticalOptions="Center"/>
                        <Entry Grid.Column="1" Text="{Binding RelayUrl}" Placeholder="http://192.168.1.100:5000"/>
                    </Grid>
                    <Grid ColumnDefinitions="80,*" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="API Key:" VerticalOptions="Center"/>
                        <Entry Grid.Column="1" Text="{Binding RelayApiKey}" Placeholder="changeme" IsPassword="True"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- App Logo -->
            <Border Stroke="#CC5500" StrokeThickness="1" Padding="12" StrokeShape="RoundRectangle 6" BackgroundColor="#FFF5EE">
                <VerticalStackLayout Spacing="8">
                    <Label Text="App Logo" FontAttributes="Bold" FontSize="15" TextColor="#CC5500"/>
                    <Label Text="Image for the logo badge in the title bar. Leave blank to show initials instead."
                           TextColor="Gray" FontSize="12"/>
                    <Grid ColumnDefinitions="60,*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Image:" VerticalOptions="Center"/>
                        <Entry Grid.Column="1" Text="{Binding LogoPath}" Placeholder="C:\path\to\logo.png"/>
                        <Button Grid.Column="2" Text="Browse" Command="{Binding BrowseLogoCommand}"
                                BackgroundColor="#CC5500" TextColor="White" Padding="12,6"/>
                    </Grid>
                    <Grid ColumnDefinitions="60,120,60,120" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Initials:" VerticalOptions="Center"/>
                        <Entry Grid.Column="1" Text="{Binding LogoInitials}" Placeholder="IT" MaxLength="4"/>
                        <Label Grid.Column="2" Text="Color:" VerticalOptions="Center"/>
                        <Entry Grid.Column="3" Text="{Binding LogoColor}" Placeholder="#0078D4"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Data Source Toggle -->
            <Border Stroke="LightGray" StrokeThickness="1" Padding="12" StrokeShape="RoundRectangle 6">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Data Source" FontAttributes="Bold" FontSize="15"/>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Switch Grid.Column="0" IsToggled="{Binding UseMockData}"/>
                        <Label Grid.Column="1" Text="Use simulated (mock) data — no live Microsoft 365 required"
                               VerticalOptions="Center"/>
                    </Grid>
                    <!-- Restart banner -->
                    <Border Padding="10,8" BackgroundColor="#FFF3E0" StrokeShape="RoundRectangle 4"
                            Stroke="#FFB74D" IsVisible="{Binding RestartRequired}">
                        <Label Text="⚠ Restart the app after saving to apply the data source change."
                               TextColor="#E65100" FontSize="12"/>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Save + Status -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Grid.Column="0" Text="Save Settings" Command="{Binding SaveCommand}"
                        BackgroundColor="ForestGreen" Padding="20,10"/>
                <Border Grid.Column="1" Padding="12,8" BackgroundColor="#E8F5E9"
                        StrokeShape="RoundRectangle 6" Stroke="#A5D6A7"
                        IsVisible="{Binding HasStatus}" VerticalOptions="Center">
                    <Label Text="{Binding StatusMessage}" TextColor="#2E7D32" FontSize="13"/>
                </Border>
            </Grid>

            <BoxView HeightRequest="20"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
