<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SupportToolApp.Pages.Email.EmailPage"
             Title="Email &amp; Mailbox">
    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="14">

            <!-- Mailbox Lookup -->
            <Border Stroke="LightGray" StrokeThickness="1" Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Mailbox Lookup" FontAttributes="Bold" FontSize="15"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry Text="{Binding LookupAddress}" Placeholder="user@contoso.com" ReturnCommand="{Binding LookupCommand}"/>
                        <Button Grid.Column="1" Text="Lookup" Command="{Binding LookupCommand}" Margin="4,0,0,0"/>
                    </Grid>
                    <VerticalStackLayout IsVisible="{Binding HasMailbox}" Spacing="6">
                        <Label Text="{Binding Mailbox.DisplayName}" FontAttributes="Bold" FontSize="16"/>
                        <Label Text="{Binding Mailbox.PrimarySmtpAddress}" TextColor="Gray"/>
                        <Label Text="{Binding MailboxSizeDisplay}" FontSize="12"/>
                        <Label Text="Email Addresses" FontAttributes="Bold" FontSize="13" Margin="0,4,0,0"/>
                        <CollectionView ItemsSource="{Binding Mailbox.EmailAddresses}" HeightRequest="60">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding .}" FontFamily="Courier New" FontSize="12" Padding="4,1"/>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Label Text="Delegated Permissions" FontAttributes="Bold" FontSize="13" Margin="0,4,0,0"/>
                        <Label Text="{Binding PermissionsDisplay}" FontSize="12" TextColor="Gray"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Forwarding -->
            <Border Stroke="LightGray" StrokeThickness="1" Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Email Forwarding" FontAttributes="Bold" FontSize="15"/>
                    <Label Text="From mailbox:" FontSize="12" TextColor="Gray"/>
                    <Entry Text="{Binding ForwardFrom}" Placeholder="source@contoso.com"/>
                    <Label Text="Forward to:" FontSize="12" TextColor="Gray"/>
                    <Entry Text="{Binding ForwardTo}" Placeholder="destination@contoso.com"/>
                    <Grid ColumnDefinitions="Auto,*">
                        <CheckBox Grid.Column="0" IsChecked="{Binding KeepForwardCopy}"/>
                        <Label Grid.Column="1" Text="Keep a copy in the source mailbox" VerticalOptions="Center"/>
                    </Grid>
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Set Forwarding" Command="{Binding SetForwardingCommand}" BackgroundColor="#228B22"/>
                        <Button Text="Clear Forwarding" Command="{Binding ClearForwardingCommand}" BackgroundColor="#CC4400"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Delegation -->
            <Border Stroke="LightGray" StrokeThickness="1" Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Mailbox Delegation" FontAttributes="Bold" FontSize="15"/>
                    <Label Text="Target mailbox:" FontSize="12" TextColor="Gray"/>
                    <Entry Text="{Binding DelegateMailbox}" Placeholder="mailbox@contoso.com"/>
                    <Label Text="Grant access to:" FontSize="12" TextColor="Gray"/>
                    <Entry Text="{Binding DelegateUser}" Placeholder="user@contoso.com"/>
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Grant Full Access" Command="{Binding GrantAccessCommand}" BackgroundColor="#1565C0"/>
                        <Button Text="Revoke Access" Command="{Binding RevokeAccessCommand}" BackgroundColor="#CC4400"/>
                        <Button Text="Add Send-As" Command="{Binding AddSendAsCommand}"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Shared Mailboxes -->
            <Border Stroke="LightGray" StrokeThickness="1" Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Shared Mailboxes" FontAttributes="Bold" FontSize="15" VerticalOptions="Center"/>
                        <Button Grid.Column="1" Text="Load" Command="{Binding LoadSharedMailboxesCommand}" Padding="12,6"/>
                    </Grid>
                    <CollectionView ItemsSource="{Binding SharedMailboxes}" HeightRequest="140">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,*,Auto" Padding="4,6" ColumnSpacing="12">
                                    <Label Grid.Column="0" Text="{Binding DisplayName}" FontAttributes="Bold"/>
                                    <Label Grid.Column="1" Text="{Binding PrimarySmtpAddress}" TextColor="Gray" FontSize="12"/>
                                    <Label Grid.Column="2" Text="{Binding MailboxType}" FontSize="11" TextColor="SlateBlue"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <Label Text="Press Load to fetch shared mailboxes." TextColor="Gray" Padding="8"/>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Parse Email Header -->
            <Border Stroke="LightGray" StrokeThickness="1" Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Parse Email Header" FontAttributes="Bold" FontSize="15"/>
                    <Label Text="Paste a raw email header below to extract the hop chain and key fields." FontSize="12" TextColor="Gray"/>
                    <Editor Text="{Binding RawHeader}" Placeholder="Paste full email header here..."
                            HeightRequest="120" FontFamily="Courier New" FontSize="11"/>
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Parse Header" Command="{Binding ParseHeaderCommand}" BackgroundColor="#0078D4"/>
                        <Button Text="Clear" Command="{Binding ClearHeaderCommand}" BackgroundColor="Gray"/>
                    </HorizontalStackLayout>
                    <Border Padding="10" Stroke="#E0E0E0" StrokeShape="RoundRectangle 4"
                            IsVisible="{Binding HasHeaderResult}" BackgroundColor="#FAFAFA">
                        <ScrollView HeightRequest="200">
                            <Label Text="{Binding HeaderResult}" FontFamily="Courier New" FontSize="11"/>
                        </ScrollView>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Status -->
            <Border Padding="12,8" BackgroundColor="#E8F5E9" StrokeShape="RoundRectangle 6"
                    IsVisible="{Binding HasStatus}" Stroke="#A5D6A7">
                <Label Text="{Binding StatusMessage}" TextColor="#2E7D32" FontAttributes="Bold"/>
            </Border>
            <Border Padding="12,8" BackgroundColor="#FFEBEE" StrokeShape="RoundRectangle 6"
                    IsVisible="{Binding HasError}" Stroke="#EF9A9A">
                <Label Text="{Binding ErrorMessage}" TextColor="#C62828" FontAttributes="Bold"/>
            </Border>

            <BoxView HeightRequest="20"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
