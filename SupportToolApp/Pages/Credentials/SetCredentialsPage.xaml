<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SupportToolApp.Pages.Credentials.SetCredentialsPage"
             Title="Session Credentials">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Session Credentials" FontSize="22" FontAttributes="Bold"/>
            <Label Text="Set once and all tools that need credentials will be pre-filled."
                   TextColor="Gray" FontSize="13"/>

            <!-- User Credentials -->
            <Border Padding="16" StrokeShape="RoundRectangle 8" Stroke="#0078D4" BackgroundColor="#F0F7FF">
                <VerticalStackLayout Spacing="10">
                    <Label Text="User Credentials" FontAttributes="Bold" FontSize="15" TextColor="#0078D4"/>
                    <Label Text="Used by: Deploy, Copy File, Run As, and all remote WinRM operations"
                           FontSize="11" TextColor="Gray"/>
                    <Grid ColumnDefinitions="70,*" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Domain:" VerticalOptions="Center"/>
                        <Entry Grid.Column="1" x:Name="EntUserDomain" Placeholder=". (local) or DOMAIN"/>
                    </Grid>
                    <Grid ColumnDefinitions="70,*" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Username:" VerticalOptions="Center"/>
                        <Entry Grid.Column="1" x:Name="EntUserUsername" Placeholder="username"/>
                    </Grid>
                    <Grid ColumnDefinitions="70,*" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Password:" VerticalOptions="Center"/>
                        <Entry Grid.Column="1" x:Name="EntUserPassword" IsPassword="True"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- O365 Credentials -->
            <Border Padding="16" StrokeShape="RoundRectangle 8" Stroke="#555" BackgroundColor="#F5F5F5">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Office 365 Credentials" FontAttributes="Bold" FontSize="15"/>
                    <Label Text="Used by: Email, User Manager, and Microsoft Graph API operations"
                           FontSize="11" TextColor="Gray"/>
                    <Grid ColumnDefinitions="70,*" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Username:" VerticalOptions="Center"/>
                        <Entry Grid.Column="1" x:Name="EntO365Username" Placeholder="user@domain.com"/>
                    </Grid>
                    <Grid ColumnDefinitions="70,*" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Password:" VerticalOptions="Center"/>
                        <Entry Grid.Column="1" x:Name="EntO365Password" IsPassword="True"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Google / Workspace Credentials -->
            <Border Padding="16" StrokeShape="RoundRectangle 8" Stroke="#4285F4" BackgroundColor="#F0F4FF">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Google / Workspace Credentials" FontAttributes="Bold" FontSize="15" TextColor="#4285F4"/>
                    <Label Text="Used by: Google Workspace admin tools and future Google API operations"
                           FontSize="11" TextColor="Gray"/>
                    <Grid ColumnDefinitions="70,*" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Username:" VerticalOptions="Center"/>
                        <Entry Grid.Column="1" x:Name="EntGoogleUsername" Placeholder="admin@yourdomain.com"/>
                    </Grid>
                    <Grid ColumnDefinitions="70,*" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Password:" VerticalOptions="Center"/>
                        <Entry Grid.Column="1" x:Name="EntGooglePassword" IsPassword="True"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Status -->
            <Label x:Name="LblStatus" TextColor="#228B22" FontSize="13" IsVisible="False"/>

            <!-- Buttons -->
            <HorizontalStackLayout Spacing="12">
                <Button Text="Save &amp; Apply" x:Name="BtnSave" Clicked="OnSave"
                        BackgroundColor="SteelBlue" TextColor="White" FontAttributes="Bold" Padding="20,10"/>
                <Button Text="Clear All" x:Name="BtnClear" Clicked="OnClear"
                        BackgroundColor="#555" TextColor="White" Padding="16,10"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
