<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SupportToolApp.Pages.Credentials.SetCredentialsPage"
             Title="Session Credentials">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Session Credentials" FontSize="22" FontAttributes="Bold"/>
            <Label Text="Set once and all tools that need credentials will be pre-filled."
                   TextColor="Gray" FontSize="13"/>

            <!-- User Credentials -->
            <Border Padding="16" StrokeShape="RoundRectangle 8" Stroke="#0078D4" BackgroundColor="#F0F7FF">
                <VerticalStackLayout Spacing="10">
                    <Label Text="User Credentials" FontAttributes="Bold" FontSize="15" TextColor="#0078D4"/>
                    <Label Text="Used by: Deploy, Copy File, Run As, and all remote WinRM operations"
                           FontSize="11" TextColor="Gray"/>
                    <Grid ColumnDefinitions="70,*" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Domain:" VerticalOptions="Center"/>
                        <Entry Grid.Column="1" x:Name="EntUserDomain" Placeholder=". (local) or DOMAIN"/>
                    </Grid>
                    <Grid ColumnDefinitions="70,*" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Username:" VerticalOptions="Center"/>
                        <Entry Grid.Column="1" x:Name="EntUserUsername" Placeholder="username"/>
                    </Grid>
                    <Grid ColumnDefinitions="70,*" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Password:" VerticalOptions="Center"/>
                        <Entry Grid.Column="1" x:Name="EntUserPassword" IsPassword="True"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- O365 Credentials -->
            <Border Padding="16" StrokeShape="RoundRectangle 8" Stroke="#555" BackgroundColor="#F5F5F5">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Office 365 Credentials" FontAttributes="Bold" FontSize="15"/>
                    <Label Text="Used by: Email, User Manager, and Microsoft Graph API operations"
                           FontSize="11" TextColor="Gray"/>
                    <Grid ColumnDefinitions="70,*" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Username:" VerticalOptions="Center"/>
                        <Entry Grid.Column="1" x:Name="EntO365Username" Placeholder="user@domain.com"/>
                    </Grid>
                    <Grid ColumnDefinitions="70,*" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Password:" VerticalOptions="Center"/>
                        <Entry Grid.Column="1" x:Name="EntO365Password" IsPassword="True"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Google / Workspace Credentials -->
            <Border Padding="16" StrokeShape="RoundRectangle 8" Stroke="#4285F4" BackgroundColor="#F0F4FF">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Google / Workspace Credentials" FontAttributes="Bold" FontSize="15" TextColor="#4285F4"/>
                    <Label Text="Used by: Google Workspace admin tools and future Google API operations"
                           FontSize="11" TextColor="Gray"/>
                    <Grid ColumnDefinitions="70,*" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Username:" VerticalOptions="Center"/>
                        <Entry Grid.Column="1" x:Name="EntGoogleUsername" Placeholder="admin@yourdomain.com"/>
                    </Grid>
                    <Grid ColumnDefinitions="70,*" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Password:" VerticalOptions="Center"/>
                        <Entry Grid.Column="1" x:Name="EntGooglePassword" IsPassword="True"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Quick Launch Buttons -->
            <Border Padding="16" StrokeShape="RoundRectangle 8" Stroke="#228B22" BackgroundColor="#F0FFF4">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Quick Launch Buttons" FontAttributes="Bold" FontSize="15" TextColor="#228B22"/>
                    <Label Text="Two configurable buttons shown in the toolbar. Enter a label and any URL (web app, OneNote, NotebookLM, etc.)"
                           FontSize="11" TextColor="Gray" LineBreakMode="WordWrap"/>
                    <Grid ColumnDefinitions="60,*,10,60,*" ColumnSpacing="6">
                        <Label Grid.Column="0" Text="Button 1:" VerticalOptions="Center" FontAttributes="Bold"/>
                        <Entry Grid.Column="1" x:Name="EntQl1Name" Placeholder="Label"/>
                        <Label Grid.Column="3" Text="URL:" VerticalOptions="Center"/>
                        <Entry Grid.Column="4" x:Name="EntQl1Url" Placeholder="https://..."/>
                    </Grid>
                    <Grid ColumnDefinitions="60,*,10,60,*" ColumnSpacing="6">
                        <Label Grid.Column="0" Text="Button 2:" VerticalOptions="Center" FontAttributes="Bold"/>
                        <Entry Grid.Column="1" x:Name="EntQl2Name" Placeholder="Label"/>
                        <Label Grid.Column="3" Text="URL:" VerticalOptions="Center"/>
                        <Entry Grid.Column="4" x:Name="EntQl2Url" Placeholder="https://..."/>
                    </Grid>
                    <Grid ColumnDefinitions="60,*,10,60,*" ColumnSpacing="6">
                        <Label Grid.Column="0" Text="Button 3:" VerticalOptions="Center" FontAttributes="Bold"/>
                        <Entry Grid.Column="1" x:Name="EntQl3Name" Placeholder="Label"/>
                        <Label Grid.Column="3" Text="URL:" VerticalOptions="Center"/>
                        <Entry Grid.Column="4" x:Name="EntQl3Url" Placeholder="https://..."/>
                    </Grid>
                    <Grid ColumnDefinitions="60,*,10,60,*" ColumnSpacing="6">
                        <Label Grid.Column="0" Text="Button 4:" VerticalOptions="Center" FontAttributes="Bold"/>
                        <Entry Grid.Column="1" x:Name="EntQl4Name" Placeholder="Label"/>
                        <Label Grid.Column="3" Text="URL:" VerticalOptions="Center"/>
                        <Entry Grid.Column="4" x:Name="EntQl4Url" Placeholder="https://..."/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Folder & Library -->
            <Border Padding="16" StrokeShape="RoundRectangle 8" Stroke="#D4500A" BackgroundColor="#FFF8F0">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Folder &amp; Library Buttons" FontAttributes="Bold" FontSize="15" TextColor="#D4500A"/>
                    <Label Text="Folder: pick any file inside your target folder — the folder path is captured. Library opens a reference URL (default: Wikipedia)."
                           FontSize="11" TextColor="Gray" LineBreakMode="WordWrap"/>
                    <Grid ColumnDefinitions="60,120,*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Folder:" VerticalOptions="Center" FontAttributes="Bold"/>
                        <Entry Grid.Column="1" x:Name="EntFolderName" Placeholder="Button name"/>
                        <Entry Grid.Column="2" x:Name="EntLocalFolder" Placeholder="C:\path\to\folder"/>
                        <Button Grid.Column="3" Text="Browse" Clicked="OnBrowseFolder"
                                BackgroundColor="#D4500A" TextColor="White" Padding="12,6"/>
                    </Grid>
                    <Grid ColumnDefinitions="60,120,*" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Library:" VerticalOptions="Center" FontAttributes="Bold"/>
                        <Entry Grid.Column="1" x:Name="EntLibraryName" Placeholder="Button name"/>
                        <Entry Grid.Column="2" x:Name="EntLibraryUrl" Placeholder="https://en.wikipedia.org/wiki/Main_Page"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- App Logo -->
            <Border Padding="16" StrokeShape="RoundRectangle 8" Stroke="#CC5500" BackgroundColor="#FFF5EE">
                <VerticalStackLayout Spacing="10">
                    <Label Text="App Logo" FontAttributes="Bold" FontSize="15" TextColor="#CC5500"/>
                    <Label Text="Image path for the logo badge in the title bar. Leave blank to use initials instead."
                           FontSize="11" TextColor="Gray" LineBreakMode="WordWrap"/>
                    <Grid ColumnDefinitions="70,*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Image:" VerticalOptions="Center"/>
                        <Entry Grid.Column="1" x:Name="EntLogoPath" Placeholder="C:\path\to\logo.png"/>
                        <Button Grid.Column="2" Text="Browse" Clicked="OnBrowseLogo"
                                BackgroundColor="#CC5500" TextColor="White" Padding="12,6"/>
                    </Grid>
                    <Grid ColumnDefinitions="70,120,70,120" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Initials:" VerticalOptions="Center"/>
                        <Entry Grid.Column="1" x:Name="EntLogoInitials" Placeholder="IT" MaxLength="4"/>
                        <Label Grid.Column="2" Text="Color:" VerticalOptions="Center"/>
                        <Entry Grid.Column="3" x:Name="EntLogoColor" Placeholder="#0078D4"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Local Only placeholder -->
            <Border Padding="16" StrokeShape="RoundRectangle 8" Stroke="#555" BackgroundColor="#2A2A2A" Opacity="0.5">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Local Only (LO) — Coming Soon" FontAttributes="Bold" FontSize="15" TextColor="#888"/>
                    <Label Text="Reserved for future local-machine functionality. Configuration will appear here."
                           FontSize="11" TextColor="#666" LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Border>

            <!-- Status -->
            <Label x:Name="LblStatus" TextColor="#228B22" FontSize="13" IsVisible="False"/>

            <!-- Buttons -->
            <HorizontalStackLayout Spacing="12">
                <Button Text="Save &amp; Apply" x:Name="BtnSave" Clicked="OnSave"
                        BackgroundColor="SteelBlue" TextColor="White" FontAttributes="Bold" Padding="20,10"/>
                <Button Text="Clear All" x:Name="BtnClear" Clicked="OnClear"
                        BackgroundColor="#555" TextColor="White" Padding="16,10"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
