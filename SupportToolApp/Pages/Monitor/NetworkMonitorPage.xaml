<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SupportToolApp.Pages.Monitor"
             x:Class="SupportToolApp.Pages.Monitor.NetworkMonitorPage"
             Title="Network Monitor">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="12" RowSpacing="8">

        <!-- Add host bar -->
        <Border Grid.Row="0" Stroke="#0078D4" StrokeThickness="1" Padding="10"
                StrokeShape="RoundRectangle 6" BackgroundColor="#F0F7FF">
            <Grid ColumnDefinitions="*,Auto,80,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" Text="{Binding NewHost}" Placeholder="Hostname or IP address"
                       ReturnCommand="{Binding AddHostCommand}" VerticalOptions="Center"/>
                <Button Grid.Column="1" Text="Add Host" Command="{Binding AddHostCommand}"
                        BackgroundColor="#0078D4" Padding="16,8"/>
                <Label Grid.Column="2" Text="Interval (s):" VerticalOptions="Center" HorizontalOptions="End"/>
                <Picker Grid.Column="3" ItemsSource="{Binding IntervalOptions}"
                        SelectedItem="{Binding IntervalSeconds}" WidthRequest="90"/>
            </Grid>
        </Border>

        <!-- Start/Stop + Ping Once -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
            <Button Grid.Column="0" Text="{Binding StartStopText}" Command="{Binding StartStopCommand}"
                    BackgroundColor="#228B22" Padding="16,8"/>
            <Button Grid.Column="1" Text="Ping Once" Command="{Binding PingAllCommand}"
                    BackgroundColor="SteelBlue" Padding="16,8"/>
            <Label Grid.Column="2" Text="{Binding StatusText}" VerticalOptions="Center"
                   TextColor="Gray" FontSize="13" Margin="8,0,0,0"/>
        </Grid>

        <!-- Host status list -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding Hosts}">
            <CollectionView.EmptyView>
                <Label Text="No hosts added. Enter a hostname or IP above and click Add Host."
                       HorizontalOptions="Center" VerticalOptions="Center"
                       TextColor="Gray" FontSize="14" Margin="0,40"/>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:MonitorEntry">
                    <Border Padding="12,8" Margin="0,2" StrokeShape="RoundRectangle 4"
                            BackgroundColor="{Binding RowColor}" Stroke="#333">
                        <Grid ColumnDefinitions="*,80,100,80,Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="{Binding Host}"
                                   FontFamily="Courier New" FontSize="14"
                                   TextColor="White" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="{Binding StatusText}"
                                   TextColor="{Binding StatusColor}" FontAttributes="Bold"
                                   FontSize="13" VerticalOptions="Center" HorizontalOptions="Center"/>
                            <Label Grid.Column="2" Text="{Binding ResponseText}"
                                   TextColor="#AAAAAA" FontSize="13"
                                   VerticalOptions="Center" HorizontalOptions="Center"/>
                            <Label Grid.Column="3" Text="{Binding LastChecked}"
                                   TextColor="#888888" FontSize="11"
                                   VerticalOptions="Center" HorizontalOptions="Center"/>
                            <Button Grid.Column="4" Text="✕" Padding="8,4"
                                    FontSize="12" BackgroundColor="#444" TextColor="#FF6666"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type local:NetworkMonitorViewModel}}, Path=RemoveHostCommand}"
                                    CommandParameter="{Binding .}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Legend -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="16" Padding="4,0">
            <BoxView Grid.Column="0" Color="#228B22" WidthRequest="14" HeightRequest="14" VerticalOptions="Center"/>
            <Label Grid.Column="1" Text="Online" FontSize="11" TextColor="Gray" VerticalOptions="Center"/>
            <BoxView Grid.Column="2" Color="#CC0000" WidthRequest="14" HeightRequest="14" VerticalOptions="Center"/>
            <Label Grid.Column="3" Text="Offline" FontSize="11" TextColor="Gray" VerticalOptions="Center"/>
        </Grid>

    </Grid>
</ContentPage>
