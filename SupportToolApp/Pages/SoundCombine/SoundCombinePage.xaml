<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SupportToolApp.Pages.SoundCombine.SoundCombinePage"
             Title="Sound Combine">

    <ContentPage.Resources>
        <Style TargetType="Button">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal"><VisualState.Setters><Setter Property="Opacity" Value="1.0"/></VisualState.Setters></VisualState>
                        <VisualState Name="PointerOver"><VisualState.Setters><Setter Property="Opacity" Value="0.80"/></VisualState.Setters></VisualState>
                        <VisualState Name="Pressed"><VisualState.Setters><Setter Property="Opacity" Value="0.60"/></VisualState.Setters></VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">

        <!-- Mode selector -->
        <HorizontalStackLayout Grid.Row="0" Spacing="8">
            <Label Text="Mode:" VerticalOptions="Center" FontAttributes="Bold"/>
            <Button Text="Simple Combine" BackgroundColor="#0078D4" TextColor="White"
                    Command="{Binding SwitchSimpleCommand}" x:Name="BtnSimple" Padding="16,8"/>
            <Button Text="Batch Prepend / Append" BackgroundColor="White" TextColor="Black"
                    Command="{Binding SwitchBatchCommand}" x:Name="BtnBatch" Padding="16,8"/>
            <ActivityIndicator IsRunning="{Binding Loading}" IsVisible="{Binding Loading}"
                               Color="#0078D4" VerticalOptions="Center" HorizontalOptions="Start"/>
        </HorizontalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12">

                <!-- ── Simple mode ── -->
                <Border IsVisible="{Binding ShowSimple}" Stroke="#DDDDDD" StrokeThickness="1"
                        Padding="16" StrokeShape="RoundRectangle 6">
                    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="10">

                        <Label Grid.Row="0" Text="Add WAV files in the order you want them combined. Nothing is modified — output goes to a new file."
                               TextColor="Gray" FontSize="12"/>

                        <HorizontalStackLayout Grid.Row="1" Spacing="8">
                            <Button Text="+ Add WAV File" Command="{Binding AddSimpleFileCommand}"
                                    BackgroundColor="#228B22" TextColor="White" Padding="14,8"/>
                            <Label Text="(add 2 or more, then set output and click Combine)"
                                   VerticalOptions="Center" TextColor="Gray" FontSize="12"/>
                        </HorizontalStackLayout>

                        <!-- File list -->
                        <Border Grid.Row="2" Stroke="#333" StrokeThickness="1" MinimumHeightRequest="120"
                                Padding="4" StrokeShape="RoundRectangle 4" BackgroundColor="#1A1A1A">
                            <CollectionView ItemsSource="{Binding SimpleFiles}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6" Padding="4,2">
                                            <Label Grid.Column="0" Text="{Binding .}" TextColor="#00FF41"
                                                   FontFamily="Courier New" FontSize="12" VerticalOptions="Center"
                                                   LineBreakMode="TailTruncation"/>
                                            <Button Grid.Column="1" Text="↑" Padding="8,4" FontSize="11"
                                                    BackgroundColor="#444" TextColor="White"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.MoveUpCommand}"
                                                    CommandParameter="{Binding .}"/>
                                            <Button Grid.Column="2" Text="↓" Padding="8,4" FontSize="11"
                                                    BackgroundColor="#444" TextColor="White"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.MoveDownCommand}"
                                                    CommandParameter="{Binding .}"/>
                                            <Button Grid.Column="3" Text="✕" Padding="8,4" FontSize="11"
                                                    BackgroundColor="#8B0000" TextColor="White"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.RemoveSimpleFileCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Border>

                        <!-- Output -->
                        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="Output file:" VerticalOptions="Center" FontAttributes="Bold"/>
                            <Entry Grid.Column="1" Text="{Binding SimpleOutput}" Placeholder="path\to\output.wav"/>
                            <Button Grid.Column="2" Text="Browse" Command="{Binding BrowseOutputCommand}"
                                    BackgroundColor="SteelBlue" TextColor="White" Padding="12,8"/>
                        </Grid>

                        <!-- Run -->
                        <Grid Grid.Row="4" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Button Grid.Column="0" Text="Combine" Command="{Binding RunSimpleCommand}"
                                    BackgroundColor="#0078D4" TextColor="White" Padding="20,10" FontAttributes="Bold"/>
                            <Label Grid.Column="1" Text="{Binding SimpleStatus}" VerticalOptions="Center"
                                   TextColor="#00BB00" FontSize="13" LineBreakMode="WordWrap"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ── Batch mode ── -->
                <Border IsVisible="{Binding ShowBatch}" Stroke="#DDDDDD" StrokeThickness="1"
                        Padding="16" StrokeShape="RoundRectangle 6">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" RowSpacing="10">

                        <Label Grid.Row="0"
                               Text="Pick a folder of WAV files and a WAV to prepend or append to all of them. Output goes to a 'combined' subfolder — originals untouched."
                               TextColor="Gray" FontSize="12"/>

                        <!-- Folder -->
                        <Grid Grid.Row="1" ColumnDefinitions="100,*,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="WAV folder:" VerticalOptions="Center" FontAttributes="Bold"/>
                            <Entry Grid.Column="1" Text="{Binding BatchFolder}" Placeholder="folder containing .wav files" IsReadOnly="True"/>
                            <Button Grid.Column="2" Text="Browse" Command="{Binding BrowseBatchFolderCommand}"
                                    BackgroundColor="SteelBlue" TextColor="White" Padding="12,8"/>
                        </Grid>

                        <!-- Add file -->
                        <Grid Grid.Row="2" ColumnDefinitions="100,*,Auto,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="Prepend/append:" VerticalOptions="Center" FontAttributes="Bold"/>
                            <Entry Grid.Column="1" Text="{Binding BatchAddFile}" Placeholder="WAV to prepend or append" IsReadOnly="True"/>
                            <Button Grid.Column="2" Text="Browse WAV" Command="{Binding BrowseBatchAddCommand}"
                                    BackgroundColor="SteelBlue" TextColor="White" Padding="12,8"/>
                            <Button Grid.Column="3" Text="Use Built-in Silence" Command="{Binding UseSilenceCommand}"
                                    BackgroundColor="#555" TextColor="White" Padding="12,8"/>
                        </Grid>

                        <!-- Prepend / Append radio -->
                        <HorizontalStackLayout Grid.Row="3" Spacing="16">
                            <Label Text="Operation:" VerticalOptions="Center" FontAttributes="Bold"/>
                            <HorizontalStackLayout Spacing="6">
                                <CheckBox IsChecked="{Binding BatchPrepend}"/>
                                <Label Text="Prepend (add to START of each file)" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="6">
                                <CheckBox IsChecked="{Binding BatchAppend}"/>
                                <Label Text="Append (add to END of each file)" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>

                        <!-- File count -->
                        <Label Grid.Row="4" Text="{Binding BatchFiles.Count, StringFormat='Files found: {0}'}"
                               TextColor="Gray" FontSize="12"/>

                        <!-- Run -->
                        <Grid Grid.Row="5" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Button Grid.Column="0" Text="Run Batch" Command="{Binding RunBatchCommand}"
                                    BackgroundColor="#0078D4" TextColor="White" Padding="20,10" FontAttributes="Bold"/>
                            <Label Grid.Column="1" Text="{Binding BatchStatus}" VerticalOptions="Center"
                                   TextColor="#00BB00" FontSize="13" LineBreakMode="WordWrap"/>
                        </Grid>

                        <!-- File list preview -->
                        <Border Grid.Row="6" Stroke="#333" StrokeThickness="1" MinimumHeightRequest="100"
                                Padding="4" StrokeShape="RoundRectangle 4" BackgroundColor="#1A1A1A">
                            <CollectionView ItemsSource="{Binding BatchFiles}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Label Text="{Binding .}" TextColor="#00FF41" FontFamily="Courier New"
                                               FontSize="12" Padding="4,2"/>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Border>

                        <Label Grid.Row="7" Text="Output saves to a 'combined' subfolder inside the selected WAV folder."
                               TextColor="Gray" FontSize="11" FontAttributes="Italic"/>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
