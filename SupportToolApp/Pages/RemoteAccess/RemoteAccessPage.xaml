<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SupportToolApp.Pages.RemoteAccess.RemoteAccessPage"
             Title="Remote Access">
    <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,*" Padding="16"
          ColumnSpacing="16" RowSpacing="12">

        <!-- Target Computer Bar -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Stroke="#0078D4" StrokeThickness="2"
                Padding="12" StrokeShape="RoundRectangle 6" BackgroundColor="#F0F7FF">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Label Grid.Column="0" Text="Target Computer:" FontAttributes="Bold"
                       VerticalOptions="Center" FontSize="14"/>
                <Entry Grid.Column="1" Text="{Binding TargetComputer}"
                       Placeholder="Enter hostname or IP — leave blank to be prompted per action"
                       FontSize="14" VerticalOptions="Center"/>
                <Button Grid.Column="2" Text="Clear" Padding="12,6"
                        BackgroundColor="Gray"
                        Command="{Binding ClearTargetCommand}"/>
            </Grid>
        </Border>

        <!-- Hint -->
        <Label Grid.Row="1" Grid.ColumnSpan="2"
               Text="All tools below use the Target Computer field. Select from a list to auto-fill it, or type directly."
               TextColor="Gray" FontSize="12"/>

        <!-- Left: Connection -->
        <Border Grid.Row="2" Grid.Column="0" Stroke="LightGray" StrokeThickness="1"
                Padding="12" StrokeShape="RoundRectangle 6">
            <VerticalStackLayout Spacing="10">
                <Label Text="Connect" FontAttributes="Bold" FontSize="15"/>

                <!-- Server list -->
                <Label Text="Servers (click to select)" TextColor="Gray" FontSize="12"/>
                <Border Stroke="LightGray" StrokeThickness="1" StrokeShape="RoundRectangle 4">
                    <CollectionView ItemsSource="{Binding Servers}" SelectionMode="Single"
                                    SelectedItem="{Binding SelectedServer}" HeightRequest="130">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Padding="8,6">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="13"/>
                                    <Label Text="{Binding Host}" TextColor="Gray" FontSize="11"/>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>

                <!-- AD Computer list -->
                <Label Text="AD Computers (click to select)" TextColor="Gray" FontSize="12"/>
                <Border Stroke="LightGray" StrokeThickness="1" StrokeShape="RoundRectangle 4">
                    <CollectionView ItemsSource="{Binding Computers}" SelectionMode="Single"
                                    SelectedItem="{Binding SelectedComputer}" HeightRequest="130">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Padding="8,4">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="13"/>
                                    <Label Text="{Binding OperatingSystem}" TextColor="Gray" FontSize="11"/>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>

                <Button Text="Connect via RDP" Command="{Binding RdpServerCommand}"
                        BackgroundColor="DodgerBlue"/>
            </VerticalStackLayout>
        </Border>

        <!-- Right: Tools + Remote Command -->
        <Border Grid.Row="2" Grid.Column="1" Stroke="LightGray" StrokeThickness="1"
                Padding="12" StrokeShape="RoundRectangle 6">
            <VerticalStackLayout Spacing="10">
                <Label Text="Remote Tools" FontAttributes="Bold" FontSize="15"/>

                <Button Text="TeamViewer" Command="{Binding TeamViewerCommand}" BackgroundColor="SteelBlue"/>
                <Button Text="{Binding DeployToolName}" Command="{Binding DeployToolCommand}" BackgroundColor="SteelBlue"/>
                <Button Text="Computer Management" Command="{Binding ComputerMgmtCommand}" BackgroundColor="SteelBlue"/>
                <Button Text="Event Viewer (Remote)" Command="{Binding EventViewerCommand}" BackgroundColor="SteelBlue"/>

                <BoxView HeightRequest="1" Color="LightGray" Margin="0,4"/>

                <Label Text="Remote Command (PowerShell)" FontAttributes="Bold" FontSize="14"/>
                <Label Text="Runs via Invoke-Command against the target computer." TextColor="Gray" FontSize="12"/>
                <Entry Text="{Binding RemoteCommand}" Placeholder="e.g. Get-Service | Where Status -eq Running"/>
                <Button Text="Run Remote Command" Command="{Binding RemoteCmdCommand}"
                        BackgroundColor="DarkSlateGray"/>

                <!-- Output -->
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasOutput}">
                    <Label Grid.Column="0" Text="Output" FontAttributes="Bold" FontSize="13"
                           VerticalOptions="Center"/>
                    <Button Grid.Column="1" Text="⤢ Pop Out" Command="{Binding PopOutCommand}"
                            FontSize="11" Padding="10,4" BackgroundColor="#444"/>
                </Grid>
                <Border Padding="8" BackgroundColor="Black" StrokeThickness="0"
                        StrokeShape="RoundRectangle 4" IsVisible="{Binding HasOutput}">
                    <ScrollView HeightRequest="200">
                        <Label Text="{Binding RemoteOutput}" FontFamily="Courier New"
                               FontSize="11" TextColor="LimeGreen"/>
                    </ScrollView>
                </Border>

                <!-- Status -->
                <Border Padding="10,8" BackgroundColor="#E8F5E9" StrokeShape="RoundRectangle 4"
                        Stroke="#A5D6A7" IsVisible="{Binding HasStatus}">
                    <Label Text="{Binding StatusMessage}" TextColor="#2E7D32" FontSize="13"/>
                </Border>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
