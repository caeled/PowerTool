<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SupportToolApp.Pages.Help.HelpPage"
             Title="Help">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">

        <!-- Search Bar -->
        <Border Grid.Row="0" Stroke="#0078D4" StrokeThickness="1" Padding="8"
                StrokeShape="RoundRectangle 6" BackgroundColor="#F0F7FF">
            <Entry x:Name="SearchEntry" Placeholder="Search help topics..."
                   TextChanged="OnSearchChanged" ClearButtonVisibility="WhileEditing"/>
        </Border>

        <!-- Help Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="HelpContainer" Spacing="16"/>
        </ScrollView>

    </Grid>
</ContentPage>
