<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SupportToolApp.Pages.Tools.ToolsPage"
             Title="Tools">
    <ContentPage.Resources>
        <Style TargetType="Button">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="1.0"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="0.80"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="0.60"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="12" RowSpacing="8">

        <!-- Target Computer Bar -->
        <Border Grid.Row="0" Stroke="#0078D4" StrokeThickness="2" Padding="10"
                StrokeShape="RoundRectangle 6" BackgroundColor="#F0F7FF">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Label Grid.Column="0" Text="Target Computer:" FontAttributes="Bold" VerticalOptions="Center"/>
                <Entry Grid.Column="1" Text="{Binding TargetComputer}"
                       Placeholder="hostname or IP â€” blank = this machine" VerticalOptions="Center"/>
                <Button Grid.Column="2" Text="Clear" Padding="10,6" BackgroundColor="Gray"
                        Command="{Binding ClearTargetCommand}"/>
            </Grid>
        </Border>

        <!-- Category Bar -->
        <HorizontalStackLayout Grid.Row="1" Spacing="4">
            <Button Text="System"  x:Name="CatSystem"  Clicked="OnCategoryClicked" BackgroundColor="#0078D4" Padding="18,8" FontSize="13" FontAttributes="Bold"/>
            <Button Text="Users"   x:Name="CatUsers"   Clicked="OnCategoryClicked" BackgroundColor="White" TextColor="Black" Padding="18,8" FontSize="13" FontAttributes="Bold"/>
            <Button Text="Network" x:Name="CatNetwork" Clicked="OnCategoryClicked" BackgroundColor="White" TextColor="Black" Padding="18,8" FontSize="13" FontAttributes="Bold"/>
            <Button Text="Remote"  x:Name="CatRemote"  Clicked="OnCategoryClicked" BackgroundColor="White" TextColor="Black" Padding="18,8" FontSize="13" FontAttributes="Bold"/>
            <Button Text="Deploy"  x:Name="CatDeploy"  Clicked="OnCategoryClicked" BackgroundColor="White" TextColor="Black" Padding="18,8" FontSize="13" FontAttributes="Bold"/>
            <Button Text="General" x:Name="CatGeneral" Clicked="OnCategoryClicked" BackgroundColor="White" TextColor="Black" Padding="18,8" FontSize="13" FontAttributes="Bold"/>
        </HorizontalStackLayout>

        <!-- Tool Bar â€” filtered by category -->
        <FlexLayout Grid.Row="2" Wrap="Wrap" Direction="Row" AlignContent="Start" AlignItems="Start" JustifyContent="Start" x:Name="TabStrip">
                <!-- System -->
                <Button Text="Installed Apps"   x:Name="TabApps"         Clicked="OnTabClicked" BackgroundColor="#0078D4" Padding="14,7" FontSize="12" Margin="0,0,4,4"/>
                <Button Text="Services"         x:Name="TabServices"      Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black"    Padding="14,7" FontSize="12" Margin="0,0,4,4"/>
                <Button Text="Updates"          x:Name="TabUpdates"       Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black"    Padding="14,7" FontSize="12" Margin="0,0,4,4"/>
                <Button Text="Security Patches" x:Name="TabPatches"       Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black"    Padding="14,7" FontSize="12" Margin="0,0,4,4"/>
                <Button Text="Processes"        x:Name="TabProcesses"     Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black"    Padding="14,7" FontSize="12" Margin="0,0,4,4"/>
                <Button Text="Printers"         x:Name="TabPrinters"      Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black"    Padding="14,7" FontSize="12" Margin="0,0,4,4"/>
                <Button Text="Disk Space"       x:Name="TabDiskSpace"     Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black"    Padding="14,7" FontSize="12" Margin="0,0,4,4"/>
                <Button Text="Scheduled Tasks"  x:Name="TabSchedTasks"    Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black"    Padding="14,7" FontSize="12" Margin="0,0,4,4"/>
                <Button Text="Activation"       x:Name="TabActivation"    Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black"    Padding="14,7" FontSize="12" Margin="0,0,4,4"/>
                <Button Text="Temp Cleanup"     x:Name="TabTempClean"     Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black"    Padding="14,7" FontSize="12" Margin="0,0,4,4"/>
                <Button Text="Startup Programs" x:Name="TabStartup"       Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black"    Padding="14,7" FontSize="12" Margin="0,0,4,4"/>
                <Button Text="Remote PS" x:Name="TabRemotePsSystem" Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4"/>
                <Button Text="PS Runner" x:Name="TabPsRunSystem"   Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4"/>
                <Button Text="Auto Logon"     x:Name="TabAutoLogon"    Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4"/>
                <Button Text="Default Printer" x:Name="TabSetPrinter"  Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4"/>
                <Button Text="Trusted Sites"  x:Name="TabTrustedSites" Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4"/>
                <Button Text="Quick Access"   x:Name="TabQuickAccess"  Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4"/>
                <Button Text="Disk Cleanup"  x:Name="TabDiskCleanup"  Clicked="OnTabClicked" BackgroundColor="#8B0000" Padding="14,7" FontSize="12" Margin="0,0,4,4"/>
                <Button Text="Keep Alive"    x:Name="TabKeepAlive"    Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4"/>
                <!-- Users -->
                <Button Text="Local Users &amp; Groups" x:Name="TabLocalUsers"      Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="Logged On User"           x:Name="TabLoggedOn"         Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="Local Admins"             x:Name="TabLocalAdmins"      Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="Run As"                   x:Name="TabRunAs"            Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="Group Membership"         x:Name="TabGroupMembership"  Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="Account Lockout"          x:Name="TabAcctLockout"      Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="RDP Sessions"             x:Name="TabRdpSessions"      Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="Password Expiry"          x:Name="TabPwdExpiry"        Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="User Management"          x:Name="TabUserMgmt"         Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="Reset AD Password"       x:Name="TabAdReset"          Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <!-- Network -->
                <Button Text="Network Info" x:Name="TabNetwork"   Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="Port Tester"  x:Name="TabPorts"     Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="Ping Sweep"   x:Name="TabPingSweep" Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="DNS"          x:Name="TabDns"       Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="Flush DNS"    x:Name="TabFlushDns"   Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="NetStat"      x:Name="TabNetStat"    Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="Traceroute"   x:Name="TabTrace"      Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="WiFi Profiles" x:Name="TabWifi"      Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="Proxy"        x:Name="TabProxy"      Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="Reset NIC"    x:Name="TabResetNic"   Clicked="OnTabClicked" BackgroundColor="#8B0000" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="Ping"         x:Name="TabPing"       Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="WiFi Setup"   x:Name="TabWifiSetup"  Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="DHCP Stats"     x:Name="TabDhcpStats"   Clicked="OnTabClicked"          BackgroundColor="White"   TextColor="Black"  Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="Network Monitor" x:Name="TabNetMonitor" Clicked="OnNetworkMonitorClicked" BackgroundColor="#0078D4" TextColor="White" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <!-- Remote -->
                <Button Text="Pending Reboot" x:Name="TabReboot"       Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="Remote Reboot"  x:Name="TabRebootAction" Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="Event Log"      x:Name="TabEventLog"     Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="Shared Folders" x:Name="TabShares"       Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="Registry"       x:Name="TabRegistry"     Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="GP Update"      x:Name="TabGpUpdate"     Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="Remote PS" x:Name="TabRemotePsRemote" Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="PS Runner"      x:Name="TabPsRunRemote"   Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="Dir Browser"    x:Name="TabDirBrowser"    Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="Process Kill"   x:Name="TabProcKill"      Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="WinRM Toggle"   x:Name="TabWinRmToggle"   Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="Wake on LAN"    x:Name="TabWakeOnLan"     Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="Hosts File"     x:Name="TabHostsFile"     Clicked="OnTabClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <!-- Deploy -->
                <Button Text="File Drop &amp; Run" x:Name="TabDeploy"    Clicked="OnTabClicked" BackgroundColor="#8B0000" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="Copy File"           x:Name="TabCopyFile"  Clicked="OnTabClicked" BackgroundColor="#8B0000" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="Winget"          x:Name="TabWinget"          Clicked="OnTabClicked" BackgroundColor="#8B0000" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="Registry Push"   x:Name="TabRegPush"         Clicked="OnTabClicked" BackgroundColor="#8B0000" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="Pending Updates" x:Name="TabPendingUpdates"  Clicked="OnTabClicked" BackgroundColor="#8B0000" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="Run Updates"     x:Name="TabRunUpdates"      Clicked="OnTabClicked" BackgroundColor="#8B0000" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="Update Log"      x:Name="TabUpdateLog"       Clicked="OnTabClicked" BackgroundColor="#8B0000" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="Windows Key"  x:Name="TabWinKey"     Clicked="OnTabClicked" BackgroundColor="#8B0000" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="WSUS Client"  x:Name="TabWsusClient" Clicked="OnTabClicked" BackgroundColor="#8B0000" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="PowerCopy"     x:Name="TabPowerCopy"    Clicked="OnTabClicked"             BackgroundColor="White"   TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <!-- General -->
                <Button Text="Compare Files" x:Name="TabCompareFiles" Clicked="OnCompareFilesClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
                <Button Text="Sound Combine" x:Name="TabSoundCombine" Clicked="OnSoundCombineClicked" BackgroundColor="White" TextColor="Black" Padding="14,7" FontSize="12" Margin="0,0,4,4" IsVisible="False"/>
        </FlexLayout>

        <!-- Status -->
        <Border Grid.Row="3" Padding="10,7" BackgroundColor="#E8F5E9" StrokeShape="RoundRectangle 4"
                Stroke="#A5D6A7" IsVisible="{Binding HasStatus}">
            <Label Text="{Binding StatusMessage}" TextColor="#2E7D32" FontSize="12"/>
        </Border>

        <!-- Tab Content -->
        <Grid Grid.Row="4">

            <!-- â”€â”€ Installed Apps â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelApps" RowDefinitions="Auto,Auto,*" RowSpacing="8" Padding="4">
                <Button Grid.Row="0" Text="Load Installed Apps" Command="{Binding LoadAppsCommand}"
                        BackgroundColor="SteelBlue" HorizontalOptions="Start" Padding="16,8"/>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0" Text="{Binding AppSearch}" Placeholder="Filter by name or publisher..."/>
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding AppsLoading}"
                                       IsVisible="{Binding AppsLoading}" Color="SteelBlue"/>
                </Grid>
                <Border Grid.Row="2" Stroke="LightGray" StrokeThickness="1" StrokeShape="RoundRectangle 4">
                    <CollectionView ItemsSource="{Binding Apps}">
                        <CollectionView.Header>
                            <Grid ColumnDefinitions="*,180,100,100" Padding="8,6" BackgroundColor="#F5F5F5" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="Name" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="1" Text="Publisher" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="2" Text="Version" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="3" Text="Installed" FontAttributes="Bold" FontSize="12"/>
                            </Grid>
                        </CollectionView.Header>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,180,100,100" Padding="8,5" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding Name}" FontSize="12"/>
                                    <Label Grid.Column="1" Text="{Binding Publisher}" FontSize="12" TextColor="Gray"/>
                                    <Label Grid.Column="2" Text="{Binding Version}" FontSize="12" TextColor="Gray"/>
                                    <Label Grid.Column="3" Text="{Binding InstallDate}" FontSize="12" TextColor="Gray"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </Grid>

            <!-- â”€â”€ Services â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelServices" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8"
                  Padding="4" IsVisible="False">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Load Services" Command="{Binding LoadServicesCommand}"
                            BackgroundColor="SteelBlue" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding ServicesLoading}"
                                       IsVisible="{Binding ServicesLoading}" Color="SteelBlue"
                                       HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Entry Grid.Row="1" Text="{Binding ServiceSearch}" Placeholder="Filter services..."/>
                <HorizontalStackLayout Grid.Row="2" Spacing="8">
                    <Button Text="Start" Command="{Binding StartServiceCommand}" BackgroundColor="#228B22" Padding="16,6"/>
                    <Button Text="Stop" Command="{Binding StopServiceCommand}" BackgroundColor="#CC4400" Padding="16,6"/>
                    <Button Text="Restart" Command="{Binding RestartServiceCommand}" BackgroundColor="#1565C0" Padding="16,6"/>
                    <Label Text="{Binding SelectedService.DisplayName, StringFormat='Selected: {0}'}"
                           VerticalOptions="Center" TextColor="Gray" FontSize="12"/>
                </HorizontalStackLayout>
                <Border Grid.Row="3" Stroke="LightGray" StrokeThickness="1" StrokeShape="RoundRectangle 4">
                    <CollectionView ItemsSource="{Binding Services}" SelectionMode="Single"
                                    SelectedItem="{Binding SelectedService}">
                        <CollectionView.Header>
                            <Grid ColumnDefinitions="140,*,90,110" Padding="8,6" BackgroundColor="#F5F5F5" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="Name" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="1" Text="Display Name" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="2" Text="Status" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="3" Text="Start Type" FontAttributes="Bold" FontSize="12"/>
                            </Grid>
                        </CollectionView.Header>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="140,*,90,110" Padding="8,5" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding Name}" FontSize="11" TextColor="Gray"/>
                                    <Label Grid.Column="1" Text="{Binding DisplayName}" FontSize="12"/>
                                    <Label Grid.Column="2" Text="{Binding Status}" FontSize="12"
                                           TextColor="{Binding IsRunning, Converter={StaticResource BoolToGreenRedConverter}}"/>
                                    <Label Grid.Column="3" Text="{Binding StartType}" FontSize="11" TextColor="Gray"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </Grid>

            <!-- â”€â”€ Local Users & Groups â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelLocalUsers" RowDefinitions="Auto,*,Auto,*" RowSpacing="8"
                  Padding="4" IsVisible="False">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Load Users &amp; Groups" Command="{Binding LoadLocalUsersCommand}"
                            BackgroundColor="SteelBlue" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding LocalUsersLoading}"
                                       IsVisible="{Binding LocalUsersLoading}" Color="SteelBlue"
                                       HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="1" Stroke="LightGray" StrokeThickness="1" StrokeShape="RoundRectangle 4">
                    <CollectionView ItemsSource="{Binding LocalUsers}">
                        <CollectionView.Header>
                            <Grid ColumnDefinitions="140,*,70,*" Padding="8,6" BackgroundColor="#F5F5F5" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="Username" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="1" Text="Full Name" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="2" Text="Enabled" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="3" Text="Last Logon" FontAttributes="Bold" FontSize="12"/>
                            </Grid>
                        </CollectionView.Header>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="140,*,70,*" Padding="8,5" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding Name}" FontSize="12" FontAttributes="Bold"/>
                                    <Label Grid.Column="1" Text="{Binding FullName}" FontSize="12"/>
                                    <Label Grid.Column="2" Text="{Binding Enabled, Converter={StaticResource BoolToEnabledConverter}}"
                                           FontSize="12" TextColor="{Binding Enabled, Converter={StaticResource BoolToGreenRedConverter}}"/>
                                    <Label Grid.Column="3" Text="{Binding LastLogon}" FontSize="12" TextColor="Gray"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
                <Label Grid.Row="2" Text="Local Groups" FontAttributes="Bold" FontSize="14"/>
                <Border Grid.Row="3" Stroke="LightGray" StrokeThickness="1" StrokeShape="RoundRectangle 4">
                    <CollectionView ItemsSource="{Binding LocalGroups}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="180,*" Padding="8,5" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding Name}" FontSize="12" FontAttributes="Bold"/>
                                    <Label Grid.Column="1" Text="{Binding MemberSummary}" FontSize="12" TextColor="Gray"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </Grid>

            <!-- â”€â”€ Printers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelPrinters" RowDefinitions="Auto,*" RowSpacing="8"
                  Padding="4" IsVisible="False">
                <!-- Add + Load row -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0" Text="{Binding NewPrinterPath}" Placeholder="\\printserver\sharename"/>
                    <Button Grid.Column="1" Text="Add" Command="{Binding AddPrinterCommand}"
                            BackgroundColor="#228B22" Padding="16,8"/>
                    <Button Grid.Column="2" Text="Load Printers" Command="{Binding LoadPrintersCommand}"
                            BackgroundColor="SteelBlue" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="3" IsRunning="{Binding PrintersLoading}"
                                       IsVisible="{Binding PrintersLoading}" Color="SteelBlue"
                                       HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="1" Stroke="LightGray" StrokeThickness="1" StrokeShape="RoundRectangle 4">
                    <CollectionView ItemsSource="{Binding Printers}">
                        <CollectionView.Header>
                            <Grid ColumnDefinitions="*,160,160,70,80" Padding="8,6" BackgroundColor="#F5F5F5" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="Name" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="1" Text="Driver" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="2" Text="Port" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="3" Text="Default" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="4" Text="Status" FontAttributes="Bold" FontSize="12"/>
                            </Grid>
                        </CollectionView.Header>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,160,160,70,80" Padding="8,5" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding Name}" FontSize="12" FontAttributes="Bold"/>
                                    <Label Grid.Column="1" Text="{Binding DriverName}" FontSize="11" TextColor="Gray"/>
                                    <Label Grid.Column="2" Text="{Binding PortName}" FontSize="11" TextColor="Gray"/>
                                    <Label Grid.Column="3" Text="{Binding IsDefault, Converter={StaticResource BoolToEnabledConverter}}" FontSize="12"/>
                                    <Label Grid.Column="4" Text="{Binding Status}" FontSize="12"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </Grid>

            <!-- â”€â”€ Pending Reboot â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelReboot" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8"
                  Padding="4" IsVisible="False">
                <Label Grid.Row="0" Text="Enter computer names (one per line or comma-separated). Leave blank to check Target Computer."
                       TextColor="Gray" FontSize="12"/>
                <Editor Grid.Row="1" Text="{Binding RebootCheckList}" HeightRequest="80"
                        Placeholder="DESKTOP-01&#x0a;DESKTOP-02&#x0a;SERVER01"/>
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Check Reboot Status" Command="{Binding CheckRebootCommand}"
                            BackgroundColor="SteelBlue" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding RebootLoading}"
                                       IsVisible="{Binding RebootLoading}" Color="SteelBlue"
                                       HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="3" Stroke="LightGray" StrokeThickness="1" StrokeShape="RoundRectangle 4">
                    <CollectionView ItemsSource="{Binding RebootResults}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="200,130,*" Padding="10,8" ColumnSpacing="12">
                                    <Label Grid.Column="0" Text="{Binding Computer}" FontSize="13"
                                           FontAttributes="Bold" VerticalOptions="Center"/>
                                    <Border Grid.Column="1" Padding="8,4" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8"
                                            BackgroundColor="{Binding StatusColor}"
                                            VerticalOptions="Center" HorizontalOptions="Start">
                                        <Label Text="{Binding StatusText}" TextColor="White"
                                               FontSize="11" FontAttributes="Bold"/>
                                    </Border>
                                    <Label Grid.Column="2" Text="{Binding Reason}" FontSize="12"
                                           TextColor="Gray" VerticalOptions="Center"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </Grid>

            <!-- â”€â”€ TCP Port Tester â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelPorts" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8"
                  Padding="4" IsVisible="False">
                <Grid Grid.Row="0" ColumnDefinitions="80,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Host:" VerticalOptions="Center" FontAttributes="Bold"/>
                    <Entry Grid.Column="1" Text="{Binding PortHost}"
                           Placeholder="hostname or IP (defaults to Target Computer)"/>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="80,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Ports:" VerticalOptions="Center" FontAttributes="Bold"/>
                    <Entry Grid.Column="1" Text="{Binding PortList}" Placeholder="80,443,3389,445,135,22"/>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Test Ports" Command="{Binding TestPortsCommand}"
                            BackgroundColor="SteelBlue" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding PortsLoading}"
                                       IsVisible="{Binding PortsLoading}" Color="SteelBlue"
                                       HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="3" Stroke="LightGray" StrokeThickness="1" StrokeShape="RoundRectangle 4">
                    <CollectionView ItemsSource="{Binding PortResults}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="100,120" Padding="12,8" ColumnSpacing="16">
                                    <Label Grid.Column="0" Text="{Binding Port, StringFormat='Port {0}'}"
                                           FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                                    <Border Grid.Column="1" Padding="10,5" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8"
                                            BackgroundColor="{Binding StatusColor}"
                                            HorizontalOptions="Start" VerticalOptions="Center">
                                        <Label Text="{Binding StatusText}" TextColor="White"
                                               FontAttributes="Bold" FontSize="12"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </Grid>

            <!-- â”€â”€ Windows Updates â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelUpdates" RowDefinitions="Auto,*" RowSpacing="8"
                  Padding="4" IsVisible="False">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Load Update History" Command="{Binding LoadUpdatesCommand}"
                            BackgroundColor="SteelBlue" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding UpdatesLoading}"
                                       IsVisible="{Binding UpdatesLoading}" Color="SteelBlue"
                                       HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="1" Stroke="LightGray" StrokeThickness="1" StrokeShape="RoundRectangle 4">
                    <CollectionView ItemsSource="{Binding Updates}">
                        <CollectionView.Header>
                            <Grid ColumnDefinitions="*,80,140,110" Padding="8,6" BackgroundColor="#F5F5F5" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="Update" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="1" Text="KB" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="2" Text="Category" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="3" Text="Installed On" FontAttributes="Bold" FontSize="12"/>
                            </Grid>
                        </CollectionView.Header>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,80,140,110" Padding="8,5" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding Title}" FontSize="12" LineBreakMode="TailTruncation"/>
                                    <Label Grid.Column="1" Text="{Binding KbNumber}" FontSize="12" FontAttributes="Bold"
                                           TextColor="#0078D4" TextDecorations="Underline"
                                           IsVisible="{Binding KbNumber, Converter={StaticResource StringNotEmptyConverter}}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenKbCommand}"
                                                CommandParameter="{Binding KbNumber}"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <Label Grid.Column="2" Text="{Binding Severity}" FontSize="12" TextColor="Gray"/>
                                    <Label Grid.Column="3" Text="{Binding InstalledOn}" FontSize="12" TextColor="Gray"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </Grid>

            <!-- â”€â”€ Network Info â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelNetwork" RowDefinitions="Auto,*" RowSpacing="8"
                  Padding="4" IsVisible="False">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Load Network Info" Command="{Binding LoadNetworkCommand}"
                            BackgroundColor="SteelBlue" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding NetworkLoading}"
                                       IsVisible="{Binding NetworkLoading}" Color="SteelBlue"
                                       HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="1" Stroke="LightGray" StrokeThickness="1" StrokeShape="RoundRectangle 4">
                    <CollectionView ItemsSource="{Binding NetworkAdapters}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="4,4" Padding="12,10" StrokeShape="RoundRectangle 6"
                                        Stroke="#DDDDDD" BackgroundColor="#FAFAFA">
                                    <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="12">
                                        <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                               Text="{Binding Name}" FontAttributes="Bold" FontSize="13"/>
                                        <Label Grid.Row="1" Grid.Column="0" Text="Description:" TextColor="Gray" FontSize="11"/>
                                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Description}" FontSize="11"/>
                                        <Label Grid.Row="2" Grid.Column="0" Text="IP Address:" TextColor="Gray" FontSize="11"/>
                                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding IPAddress}" FontSize="11"/>
                                        <Label Grid.Row="3" Grid.Column="0" Text="Gateway:" TextColor="Gray" FontSize="11"/>
                                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding DefaultGateway}" FontSize="11"/>
                                        <Label Grid.Row="4" Grid.Column="0" Text="MAC:" TextColor="Gray" FontSize="11"/>
                                        <Label Grid.Row="4" Grid.Column="1" Text="{Binding MacAddress}" FontSize="11"/>
                                        <Label Grid.Row="5" Grid.Column="0" Text="DNS:" TextColor="Gray" FontSize="11"/>
                                        <Label Grid.Row="5" Grid.Column="1" Text="{Binding DnsServers}" FontSize="11"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </Grid>

            <!-- â”€â”€ Logged On User â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelLoggedOn" RowDefinitions="Auto,Auto,*" RowSpacing="8"
                  Padding="4" IsVisible="False">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Get Logged On User" Command="{Binding GetLoggedOnUserCommand}"
                            BackgroundColor="SteelBlue" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding LoggedOnLoading}"
                                       IsVisible="{Binding LoggedOnLoading}" Color="SteelBlue"
                                       HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="1" Padding="20,16" StrokeShape="RoundRectangle 8"
                        BackgroundColor="#F0F7FF" Stroke="#0078D4">
                    <Label Text="{Binding LoggedOnResult}" FontSize="16" FontAttributes="Bold"
                           TextColor="#0078D4" HorizontalTextAlignment="Center"/>
                </Border>
                <Label Grid.Row="2" Text="Queries Win32_ComputerSystem.UserName â€” shows the interactively logged-on user for the target machine."
                       TextColor="Gray" FontSize="11" Padding="4"/>
            </Grid>

            <!-- â”€â”€ Local Admins â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelLocalAdmins" RowDefinitions="Auto,*" RowSpacing="8"
                  Padding="4" IsVisible="False">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Load Local Admins" Command="{Binding LoadLocalAdminsCommand}"
                            BackgroundColor="SteelBlue" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding LocalAdminsLoading}"
                                       IsVisible="{Binding LocalAdminsLoading}" Color="SteelBlue"
                                       HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="1" Stroke="LightGray" StrokeThickness="1" StrokeShape="RoundRectangle 4">
                    <CollectionView ItemsSource="{Binding LocalAdmins}">
                        <CollectionView.Header>
                            <Grid Padding="12,8" BackgroundColor="#FFF3E0">
                                <Label Text="Members of local Administrators group" FontAttributes="Bold"
                                       FontSize="12" TextColor="#E65100"/>
                            </Grid>
                        </CollectionView.Header>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*" Padding="14,8" ColumnSpacing="10">
                                    <Label Grid.Column="0" Text="*" FontSize="14"/>
                                    <Label Grid.Column="1" Text="{Binding .}" FontSize="13" VerticalOptions="Center"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </Grid>

            <!-- â”€â”€ Security Patches â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelPatches" RowDefinitions="Auto,*" RowSpacing="8"
                  Padding="4" IsVisible="False">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Load Security Patches" Command="{Binding LoadPatchesCommand}"
                            BackgroundColor="SteelBlue" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding PatchesLoading}"
                                       IsVisible="{Binding PatchesLoading}" Color="SteelBlue"
                                       HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="1" Stroke="LightGray" StrokeThickness="1" StrokeShape="RoundRectangle 4">
                    <CollectionView ItemsSource="{Binding Patches}">
                        <CollectionView.Header>
                            <Grid ColumnDefinitions="100,*,120,*" Padding="8,6" BackgroundColor="#F5F5F5" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="KB Article" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="1" Text="Description" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="2" Text="Installed On" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="3" Text="Installed By" FontAttributes="Bold" FontSize="12"/>
                            </Grid>
                        </CollectionView.Header>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="100,*,120,*" Padding="8,5" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding HotFixId}" FontSize="12" FontAttributes="Bold"
                                           TextColor="#0078D4" TextDecorations="Underline">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenKbCommand}"
                                                CommandParameter="{Binding HotFixId}"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <Label Grid.Column="1" Text="{Binding Description}" FontSize="12"/>
                                    <Label Grid.Column="2" Text="{Binding InstalledOn}" FontSize="12" TextColor="Gray"/>
                                    <Label Grid.Column="3" Text="{Binding InstalledBy}" FontSize="11" TextColor="Gray"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </Grid>

            <!-- â”€â”€ Process Manager â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelProcesses" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8"
                  Padding="4" IsVisible="False">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Load Processes" Command="{Binding LoadProcessesCommand}"
                            BackgroundColor="SteelBlue" Padding="16,8"/>
                    <Button Grid.Column="1" Text="Kill Process" Command="{Binding KillProcessCommand}"
                            BackgroundColor="#CC4400" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="2" IsRunning="{Binding ProcessesLoading}"
                                       IsVisible="{Binding ProcessesLoading}" Color="SteelBlue"
                                       HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Entry Grid.Row="1" Text="{Binding ProcessSearch}" Placeholder="Filter processes..."/>
                <Label Grid.Row="2" Text="{Binding SelectedProcess.Name, StringFormat='Selected: {0}'}"
                       FontSize="12" TextColor="Gray" Padding="4,0"/>
                <Border Grid.Row="3" Stroke="LightGray" StrokeThickness="1" StrokeShape="RoundRectangle 4">
                    <CollectionView ItemsSource="{Binding Processes}" SelectionMode="Single"
                                    SelectedItem="{Binding SelectedProcess}">
                        <CollectionView.Header>
                            <Grid ColumnDefinitions="60,180,80,100,120,*" Padding="8,6" BackgroundColor="#F5F5F5" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="PID" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="1" Text="Name" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="2" Text="CPU (s)" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="3" Text="Memory" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="4" Text="Start Time" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="5" Text="Owner" FontAttributes="Bold" FontSize="12"/>
                            </Grid>
                        </CollectionView.Header>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="60,180,80,100,120,*" Padding="8,5" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding Id}" FontSize="11" TextColor="Gray"/>
                                    <Label Grid.Column="1" Text="{Binding Name}" FontSize="12"/>
                                    <Label Grid.Column="2" Text="{Binding CPU}" FontSize="11" TextColor="Gray"/>
                                    <Label Grid.Column="3" Text="{Binding WorkingSet}" FontSize="11" TextColor="Gray"/>
                                    <Label Grid.Column="4" Text="{Binding StartTime}" FontSize="11" TextColor="Gray"/>
                                    <Label Grid.Column="5" Text="{Binding Owner}" FontSize="11" TextColor="Gray"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </Grid>

            <!-- â”€â”€ Remote Reboot â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelRebootAction" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12"
                  Padding="4" IsVisible="False">
                <Label Grid.Row="0"
                       Text="Use the Target Computer field above to set the machine. Actions are confirmed before executing."
                       TextColor="Gray" FontSize="12"/>
                <HorizontalStackLayout Grid.Row="1" Spacing="10">
                    <Button Text="Reboot Now" Command="{Binding RebootNowCommand}"
                            BackgroundColor="#CC4400" Padding="18,10" FontAttributes="Bold"/>
                    <Button Text="Cancel Reboot" Command="{Binding CancelRebootCommand}"
                            BackgroundColor="White" TextColor="Black" Padding="18,10"/>
                    <Button Text="Enable RDP" Command="{Binding EnableRdpCommand}"
                            BackgroundColor="#1565C0" Padding="18,10"/>
                    <ActivityIndicator IsRunning="{Binding RebootActionLoading}"
                                       IsVisible="{Binding RebootActionLoading}" Color="SteelBlue"
                                       VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <Border Grid.Row="2" Padding="14,10" StrokeShape="RoundRectangle 6"
                        BackgroundColor="#1A1A1A" Stroke="#333">
                    <Label Text="{Binding RebootOutput}" FontFamily="Courier New" FontSize="12"
                           TextColor="#00FF41"/>
                </Border>
                <Label Grid.Row="3"
                       Text="Reboot schedules a 30-second countdown (users see a warning). Cancel aborts any pending shutdown. Enable RDP sets the registry key and opens the firewall rule remotely."
                       TextColor="Gray" FontSize="11" Padding="4"/>
            </Grid>

            <!-- â”€â”€ Ping Sweep â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelPingSweep" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8"
                  Padding="4" IsVisible="False">
                <Label Grid.Row="0" Text="Enter a subnet prefix (e.g. 192.168.1) â€” sweeps .1 through .254 in parallel."
                       TextColor="Gray" FontSize="12"/>
                <Grid Grid.Row="1" ColumnDefinitions="80,*,Auto,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Subnet:" VerticalOptions="Center" FontAttributes="Bold"/>
                    <Entry Grid.Column="1" Text="{Binding SweepSubnet}" Placeholder="192.168.1"/>
                    <Button Grid.Column="2" Text="Sweep" Command="{Binding PingSweepCommand}"
                            BackgroundColor="SteelBlue" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="3" IsRunning="{Binding SweepLoading}"
                                       IsVisible="{Binding SweepLoading}" Color="SteelBlue"
                                       VerticalOptions="Center"/>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="{Binding SweepResults.Count, StringFormat='{0} results'}"
                           FontSize="12" TextColor="Gray" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="3" Stroke="LightGray" StrokeThickness="1" StrokeShape="RoundRectangle 4">
                    <CollectionView ItemsSource="{Binding SweepResults}">
                        <CollectionView.Header>
                            <Grid ColumnDefinitions="140,120,*" Padding="8,6" BackgroundColor="#F5F5F5" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="IP Address" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="1" Text="Status" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="2" Text="Hostname" FontAttributes="Bold" FontSize="12"/>
                            </Grid>
                        </CollectionView.Header>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="140,120,*" Padding="8,5" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding IPAddress}" FontSize="12"/>
                                    <Border Grid.Column="1" Padding="8,4" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8"
                                            BackgroundColor="{Binding StatusColor}"
                                            HorizontalOptions="Start" VerticalOptions="Center">
                                        <Label Text="{Binding StatusText}" TextColor="White"
                                               FontSize="11" FontAttributes="Bold"/>
                                    </Border>
                                    <Label Grid.Column="2" Text="{Binding Hostname}" FontSize="12" TextColor="Gray"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </Grid>

            <!-- â”€â”€ Run As â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelRunAs" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" RowSpacing="8"
                  Padding="4" IsVisible="False">
                <Label Grid.Row="0"
                       Text="Run a command or manage a service using alternate credentials. Password is passed to PowerShell SecureString â€” not stored."
                       TextColor="Gray" FontSize="12"/>
                <Grid Grid.Row="1" ColumnDefinitions="80,120,80,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Domain:" VerticalOptions="Center" FontAttributes="Bold"/>
                    <Entry Grid.Column="1" Text="{Binding RunAsDomain}" Placeholder=". or DOMAIN"/>
                    <Label Grid.Column="2" Text="Username:" VerticalOptions="Center" FontAttributes="Bold"/>
                    <Entry Grid.Column="3" Text="{Binding RunAsUsername}" Placeholder="username"/>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="80,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Password:" VerticalOptions="Center" FontAttributes="Bold"/>
                    <Entry Grid.Column="1" Text="{Binding RunAsPassword}" IsPassword="True" Placeholder="password"/>
                </Grid>
                <Grid Grid.Row="3" ColumnDefinitions="80,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Command:" VerticalOptions="Center" FontAttributes="Bold"/>
                    <Entry Grid.Column="1" Text="{Binding RunAsCommand}" Placeholder="notepad.exe  â€” or service name for Start/Stop"/>
                </Grid>
                <Grid Grid.Row="4" ColumnDefinitions="80,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Arguments:" VerticalOptions="Center" FontAttributes="Bold"/>
                    <Entry Grid.Column="1" Text="{Binding RunAsArgs}" Placeholder="optional arguments"/>
                </Grid>
                <HorizontalStackLayout Grid.Row="5" Spacing="10">
                    <Button Text="Run / Launch" Command="{Binding RunAsExecuteCommand}"
                            BackgroundColor="#228B22" Padding="16,8" FontAttributes="Bold"/>
                    <Button Text="Start Service" Command="{Binding RunAsStartServiceCommand}"
                            BackgroundColor="#1565C0" Padding="16,8"/>
                    <Button Text="Stop Service" Command="{Binding RunAsStopServiceCommand}"
                            BackgroundColor="#CC4400" Padding="16,8"/>
                    <ActivityIndicator IsRunning="{Binding RunAsLoading}" IsVisible="{Binding RunAsLoading}"
                                       Color="SteelBlue" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <Border Grid.Row="6" Padding="14,10" StrokeShape="RoundRectangle 6"
                        BackgroundColor="#1A1A1A" Stroke="#333">
                    <Label Text="{Binding RunAsOutput}" FontFamily="Courier New" FontSize="12"
                           TextColor="#00FF41"/>
                </Border>
            </Grid>

            <!-- â”€â”€ Event Log â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelEventLog" RowDefinitions="Auto,Auto,*" RowSpacing="8"
                  Padding="4" IsVisible="False">
                <Grid Grid.Row="0" ColumnDefinitions="70,140,70,80,Auto,Auto,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Log:" VerticalOptions="Center" FontAttributes="Bold"/>
                    <Entry Grid.Column="1" Text="{Binding EventLogName}" Placeholder="System"/>
                    <Label Grid.Column="2" Text="Count:" VerticalOptions="Center" FontAttributes="Bold"/>
                    <Entry Grid.Column="3" Text="{Binding EventLogCount}" Placeholder="50"/>
                    <Button Grid.Column="4" Text="System" Padding="10,6" FontSize="11"
                            BackgroundColor="White" TextColor="Black" Clicked="OnEventLogPreset"/>
                    <Button Grid.Column="5" Text="Application" Padding="10,6" FontSize="11"
                            BackgroundColor="White" TextColor="Black" Clicked="OnEventLogPreset"/>
                    <Button Grid.Column="6" Text="Security" Padding="10,6" FontSize="11"
                            BackgroundColor="White" TextColor="Black" Clicked="OnEventLogPreset" HorizontalOptions="Start"/>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Load Events" Command="{Binding LoadEventLogCommand}"
                            BackgroundColor="SteelBlue" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding EventLogLoading}"
                                       IsVisible="{Binding EventLogLoading}" Color="SteelBlue"
                                       HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="2" Stroke="LightGray" StrokeThickness="1" StrokeShape="RoundRectangle 4">
                    <CollectionView ItemsSource="{Binding EventLogEntries}">
                        <CollectionView.Header>
                            <Grid ColumnDefinitions="130,70,160,60,*" Padding="8,6" BackgroundColor="#F5F5F5" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="Time" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="1" Text="Type" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="2" Text="Source" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="3" Text="ID" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="4" Text="Message" FontAttributes="Bold" FontSize="12"/>
                            </Grid>
                        </CollectionView.Header>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="130,70,160,60,*" Padding="8,5" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding TimeGenerated}" FontSize="11" TextColor="Gray"/>
                                    <Label Grid.Column="1" Text="{Binding EntryType}" FontSize="11"
                                           TextColor="{Binding TypeColor}" FontAttributes="Bold"/>
                                    <Label Grid.Column="2" Text="{Binding Source}" FontSize="11" TextColor="Gray"/>
                                    <Label Grid.Column="3" Text="{Binding EventId}" FontSize="11" TextColor="Gray"/>
                                    <Label Grid.Column="4" Text="{Binding Message}" FontSize="11"
                                           LineBreakMode="TailTruncation"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </Grid>

            <!-- â”€â”€ Shared Folders â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelShares" RowDefinitions="Auto,*,Auto" RowSpacing="8"
                  Padding="4" IsVisible="False">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Load Shares" Command="{Binding LoadSharesCommand}"
                            BackgroundColor="SteelBlue" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding SharesLoading}"
                                       IsVisible="{Binding SharesLoading}" Color="SteelBlue"
                                       HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="1" Stroke="LightGray" StrokeThickness="1" StrokeShape="RoundRectangle 4">
                    <CollectionView ItemsSource="{Binding Shares}">
                        <CollectionView.Header>
                            <Grid ColumnDefinitions="140,*,200,80" Padding="8,6" BackgroundColor="#F5F5F5" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="Share Name" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="1" Text="Path" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="2" Text="Description" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="3" Text="Type" FontAttributes="Bold" FontSize="12"/>
                            </Grid>
                        </CollectionView.Header>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="140,*,200,80" Padding="8,5" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding Name}" FontSize="12" FontAttributes="Bold"/>
                                    <Label Grid.Column="1" Text="{Binding Path}" FontSize="12"/>
                                    <Label Grid.Column="2" Text="{Binding Description}" FontSize="11" TextColor="Gray"/>
                                    <Label Grid.Column="3" Text="{Binding Type}" FontSize="11" TextColor="Gray"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
                <Grid Grid.Row="2" ColumnDefinitions="120,*,*,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0" Text="{Binding NewShareName}" Placeholder="ShareName"/>
                    <Entry Grid.Column="1" Text="{Binding NewSharePath}" Placeholder="C:\Path\To\Folder"/>
                    <Entry Grid.Column="2" Text="{Binding NewShareDesc}" Placeholder="Description (optional)"/>
                    <Button Grid.Column="3" Text="Add Share" Command="{Binding AddShareCommand}"
                            BackgroundColor="#228B22" Padding="12,6"/>
                </Grid>
            </Grid>

            <!-- â”€â”€ File Drop & Execute â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelDeploy" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="8"
                  Padding="4" IsVisible="False">
                <Border Grid.Row="0" Padding="10,8" BackgroundColor="#FFF8E1" Stroke="#FFB300"
                        StrokeShape="RoundRectangle 4">
                    <Label FontSize="12" TextColor="#5D4037">
                        <Label.Text>Workflow: Creates a temp share on the remote machine â†’ maps it locally â†’ copies your script â†’ removes share â†’ executes remotely. Credentials must have admin rights on the target.</Label.Text>
                    </Label>
                </Border>
                <Grid Grid.Row="1" ColumnDefinitions="80,120,80,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Domain:" VerticalOptions="Center" FontAttributes="Bold"/>
                    <Entry Grid.Column="1" Text="{Binding DeployDomain}" Placeholder=". or DOMAIN"/>
                    <Label Grid.Column="2" Text="Username:" VerticalOptions="Center" FontAttributes="Bold"/>
                    <Entry Grid.Column="3" Text="{Binding DeployUsername}" Placeholder="admin username"/>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="80,*,120,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Password:" VerticalOptions="Center" FontAttributes="Bold"/>
                    <Entry Grid.Column="1" Text="{Binding DeployPassword}" IsPassword="True"/>
                    <Label Grid.Column="2" Text="Remote Path:" VerticalOptions="Center" FontAttributes="Bold"/>
                    <Entry Grid.Column="3" Text="{Binding DeployRemotePath}" Placeholder="C:\Windows\Temp"/>
                </Grid>
                <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0" Text="{Binding DeployScriptName}" Placeholder="script.ps1"/>
                    <Button Grid.Column="1" Text="Browse" Command="{Binding DeployBrowseCommand}"
                            BackgroundColor="White" TextColor="Black" Padding="12,6"/>
                    <CheckBox Grid.Column="2" IsChecked="{Binding DeployExecute}" VerticalOptions="Center"/>
                    <Label Grid.Column="3" Text="Execute after drop" VerticalOptions="Center" FontSize="12"/>
                    <ActivityIndicator Grid.Column="4" IsRunning="{Binding DeployLoading}"
                                       IsVisible="{Binding DeployLoading}" Color="SteelBlue"
                                       VerticalOptions="Center"/>
                </Grid>
                <Grid Grid.Row="4" RowDefinitions="*,200" RowSpacing="4">
                    <Border Grid.Row="0" Stroke="#333" StrokeThickness="1" StrokeShape="RoundRectangle 4">
                        <Editor Text="{Binding DeployScriptContent}" FontFamily="Courier New" FontSize="11"
                                Placeholder="Paste script content here, or use Browse to load a file..."
                                BackgroundColor="#1E1E1E" TextColor="#D4D4D4"/>
                    </Border>
                    <Border Grid.Row="1" Padding="10,8" StrokeShape="RoundRectangle 4"
                            BackgroundColor="#0D0D0D" Stroke="#333">
                        <CollectionView ItemsSource="{Binding DeployLog}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Label FontFamily="Courier New" FontSize="11" TextColor="#00FF41"
                                           Text="{Binding Message}" Padding="0,1"/>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>
                </Grid>
                <Button Grid.Row="5" Text="Deploy &amp; Run" Command="{Binding DeployRunCommand}"
                        BackgroundColor="#8B0000" TextColor="White" FontAttributes="Bold"
                        Padding="20,10" HorizontalOptions="Start"/>
            </Grid>

            <!-- â”€â”€ Disk Space â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelDiskSpace" RowDefinitions="Auto,*" RowSpacing="8"
                  Padding="4" IsVisible="False">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Load Disk Space" Command="{Binding LoadDiskSpaceCommand}"
                            BackgroundColor="SteelBlue" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding DiskSpaceLoading}"
                                       IsVisible="{Binding DiskSpaceLoading}" Color="SteelBlue"
                                       HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="1" Stroke="LightGray" StrokeThickness="1" StrokeShape="RoundRectangle 4">
                    <CollectionView ItemsSource="{Binding DriveEntries}">
                        <CollectionView.Header>
                            <Grid ColumnDefinitions="60,120,80,80,80,80" Padding="8,6" BackgroundColor="#F5F5F5" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="Drive" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="1" Text="Label" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="2" Text="Size GB" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="3" Text="Used GB" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="4" Text="Free GB" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="5" Text="% Used" FontAttributes="Bold" FontSize="12"/>
                            </Grid>
                        </CollectionView.Header>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="60,120,80,80,80,80" Padding="8,5" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding Drive}" FontSize="12" FontAttributes="Bold"/>
                                    <Label Grid.Column="1" Text="{Binding Label}" FontSize="12" TextColor="Gray"/>
                                    <Label Grid.Column="2" Text="{Binding SizeGB}" FontSize="12" TextColor="Gray"/>
                                    <Label Grid.Column="3" Text="{Binding UsedGB}" FontSize="12" TextColor="Gray"/>
                                    <Label Grid.Column="4" Text="{Binding FreeGB}" FontSize="12" TextColor="Gray"/>
                                    <Label Grid.Column="5" Text="{Binding PctUsed, StringFormat='{0}%'}"
                                           FontSize="12" FontAttributes="Bold"
                                           TextColor="{Binding PctColor}"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </Grid>

            <!-- â”€â”€ Group Membership â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelGroupMembership" RowDefinitions="Auto,*" RowSpacing="8"
                  Padding="4" IsVisible="False">
                <Grid Grid.Row="0" ColumnDefinitions="60,140,60,140,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Group:" VerticalOptions="Center" FontAttributes="Bold"/>
                    <Entry Grid.Column="1" Text="{Binding GrpMemberGroup}" Placeholder="Administrators"/>
                    <Label Grid.Column="2" Text="User:" VerticalOptions="Center" FontAttributes="Bold"/>
                    <Entry Grid.Column="3" Text="{Binding GrpMemberUser}" Placeholder="username"/>
                    <Button Grid.Column="4" Text="Add" Command="{Binding AddToGroupCommand}"
                            BackgroundColor="#228B22" Padding="14,8"/>
                    <Button Grid.Column="5" Text="Remove" Command="{Binding RemoveFromGroupCommand}"
                            BackgroundColor="#CC4400" Padding="14,8"/>
                    <Button Grid.Column="6" Text="List Members" Command="{Binding ListGroupMembersCommand}"
                            BackgroundColor="SteelBlue" Padding="14,8"/>
                    <ActivityIndicator Grid.Column="7" IsRunning="{Binding GroupMemberLoading}"
                                       IsVisible="{Binding GroupMemberLoading}" Color="SteelBlue"
                                       VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="1" Stroke="LightGray" StrokeThickness="1" StrokeShape="RoundRectangle 4">
                    <CollectionView ItemsSource="{Binding GroupMembers}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Label Text="{Binding .}" FontSize="12" Padding="12,6"/>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </Grid>

            <!-- â”€â”€ Account Lockout â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelAcctLockout" RowDefinitions="Auto,Auto,*" RowSpacing="10"
                  Padding="4" IsVisible="False">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Username:" VerticalOptions="Center" LineBreakMode="NoWrap"/>
                    <Entry Grid.Column="1" Text="{Binding LockoutUsername}" Placeholder="username to check"/>
                    <Button Grid.Column="2" Text="Check" Command="{Binding CheckLockoutCommand}"
                            BackgroundColor="SteelBlue" Padding="14,8"/>
                    <Button Grid.Column="3" Text="Unlock" Command="{Binding UnlockAccountCommand}"
                            BackgroundColor="#228B22" Padding="14,8"/>
                    <Button Grid.Column="4" Text="Reset Bad Pwd Count" Command="{Binding ResetBadPwdCommand}"
                            BackgroundColor="#CC4400" Padding="14,8"/>
                    <ActivityIndicator Grid.Column="5" IsRunning="{Binding LockoutLoading}"
                                       IsVisible="{Binding LockoutLoading}" Color="SteelBlue" VerticalOptions="Center"/>
                </Grid>
                <!-- Status banner -->
                <Border Grid.Row="1" Padding="12,8" StrokeShape="RoundRectangle 4"
                        BackgroundColor="{Binding LockoutStatusColor}" Stroke="#444" IsVisible="{Binding LockoutStatusVisible}">
                    <Label Text="{Binding LockoutStatusText}" FontAttributes="Bold" FontSize="13" TextColor="White"/>
                </Border>
                <Border Grid.Row="2" Stroke="LightGray" StrokeShape="RoundRectangle 4" Padding="14,10">
                    <Label Text="{Binding LockoutDetails}" FontFamily="Consolas" FontSize="12" LineBreakMode="CharacterWrap"/>
                </Border>
            </Grid>

            <!-- â”€â”€ RDP Sessions â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelRdpSessions" RowDefinitions="Auto,*,Auto" RowSpacing="10"
                  Padding="4" IsVisible="False">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="List Sessions" Command="{Binding ListRdpCommand}"
                            BackgroundColor="SteelBlue" Padding="14,8"/>
                    <Button Grid.Column="1" Text="Kick Selected" Command="{Binding KickRdpCommand}"
                            BackgroundColor="#CC4400" Padding="14,8"/>
                    <ActivityIndicator Grid.Column="2" IsRunning="{Binding RdpLoading}"
                                       IsVisible="{Binding RdpLoading}" Color="SteelBlue" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="1" Stroke="LightGray" StrokeShape="RoundRectangle 4">
                    <CollectionView ItemsSource="{Binding RdpSessions}" SelectionMode="Single"
                                    SelectedItem="{Binding RdpSelectedSession}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="80,120,80,80,*" ColumnSpacing="8" Padding="12,6">
                                    <Label Grid.Column="0" Text="{Binding SessionId}" FontSize="12" FontAttributes="Bold"/>
                                    <Label Grid.Column="1" Text="{Binding Username}"  FontSize="12"/>
                                    <Label Grid.Column="2" Text="{Binding State}"     FontSize="12"/>
                                    <Label Grid.Column="3" Text="{Binding IdleTime}"  FontSize="12" TextColor="Gray"/>
                                    <Label Grid.Column="4" Text="{Binding LogonTime}" FontSize="12" TextColor="Gray"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
                <Label Grid.Row="2" Text="{Binding RdpStatus}" FontSize="12" TextColor="#228B22"/>
            </Grid>

            <!-- â”€â”€ Password Expiry â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelPwdExpiry" RowDefinitions="Auto,*" RowSpacing="10"
                  Padding="4" IsVisible="False">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Username:" VerticalOptions="Center" LineBreakMode="NoWrap"/>
                    <Entry Grid.Column="1" Text="{Binding PwdExpiryUsername}" Placeholder="username (blank = all local users)"/>
                    <Button Grid.Column="2" Text="Check" Command="{Binding CheckPwdExpiryCommand}"
                            BackgroundColor="SteelBlue" Padding="14,8"/>
                    <ActivityIndicator Grid.Column="3" IsRunning="{Binding PwdExpiryLoading}"
                                       IsVisible="{Binding PwdExpiryLoading}" Color="SteelBlue" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="1" Stroke="LightGray" StrokeShape="RoundRectangle 4">
                    <CollectionView ItemsSource="{Binding PwdExpiryResults}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="140,100,120,*" ColumnSpacing="8" Padding="12,6">
                                    <Label Grid.Column="0" Text="{Binding Username}"   FontSize="12" FontAttributes="Bold"/>
                                    <Label Grid.Column="1" Text="{Binding Enabled}"    FontSize="12"/>
                                    <Label Grid.Column="2" Text="{Binding ExpiryDate}" FontSize="12"
                                           TextColor="{Binding ExpiryColor}"/>
                                    <Label Grid.Column="3" Text="{Binding DaysLeft}"   FontSize="12" TextColor="Gray"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </Grid>

            <!-- â”€â”€ User Management â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelUserMgmt" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10"
                  Padding="4" IsVisible="False">

                <!-- Admin credentials (required for remote user ops) -->
                <Grid Grid.Row="0" ColumnDefinitions="60,120,80,*,80,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Domain:"   VerticalOptions="Center" LineBreakMode="NoWrap"/>
                    <Entry Grid.Column="1" Text="{Binding UserMgmtDomain}"   Placeholder=". or DOMAIN"/>
                    <Label Grid.Column="2" Text="Username:" VerticalOptions="Center" LineBreakMode="NoWrap"/>
                    <Entry Grid.Column="3" Text="{Binding UserMgmtUsername}" Placeholder="admin username"/>
                    <Label Grid.Column="4" Text="Password:" VerticalOptions="Center" LineBreakMode="NoWrap"/>
                    <Entry Grid.Column="5" Text="{Binding UserMgmtPassword}" IsPassword="True"/>
                </Grid>

                <!-- Create User section -->
                <Border Grid.Row="1" Padding="14,12" Stroke="#0078D4" StrokeShape="RoundRectangle 6">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                        <Label Grid.Row="0" Text="Create Local User" FontAttributes="Bold" FontSize="14" TextColor="#0078D4"/>
                        <Grid Grid.Row="1" ColumnDefinitions="80,*,80,*,80,*" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="Username:"    VerticalOptions="Center" LineBreakMode="NoWrap"/>
                            <Entry Grid.Column="1" Text="{Binding NewUserUsername}" Placeholder="username"/>
                            <Label Grid.Column="2" Text="Full Name:"   VerticalOptions="Center" LineBreakMode="NoWrap"/>
                            <Entry Grid.Column="3" Text="{Binding NewUserFullName}" Placeholder="Display name"/>
                            <Label Grid.Column="4" Text="Description:" VerticalOptions="Center" LineBreakMode="NoWrap"/>
                            <Entry Grid.Column="5" Text="{Binding NewUserDescription}" Placeholder="optional"/>
                        </Grid>
                        <Grid Grid.Row="2" ColumnDefinitions="80,*,80,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="Password:"     VerticalOptions="Center" LineBreakMode="NoWrap"/>
                            <Entry Grid.Column="1" Text="{Binding NewUserPassword}" IsPassword="True" Placeholder="initial password"/>
                            <Label Grid.Column="2" Text="Add to Group:" VerticalOptions="Center" LineBreakMode="NoWrap"/>
                            <Entry Grid.Column="3" Text="{Binding NewUserGroup}" Placeholder="Administrators / Users / etc."/>
                            <CheckBox Grid.Column="4" IsChecked="{Binding NewUserPwdNeverExpires}" VerticalOptions="Center"/>
                            <Label Grid.Column="5" Text="Pwd Never Expires" VerticalOptions="Center" FontSize="12"/>
                            <CheckBox Grid.Column="6" IsChecked="{Binding NewUserAddRdp}" VerticalOptions="Center"/>
                            <Label Grid.Column="7" Text="Add to RDP" VerticalOptions="Center" FontSize="12"/>
                            <Button Grid.Column="8" Text="Create User" Command="{Binding CreateUserCommand}"
                                    BackgroundColor="#228B22" TextColor="White" FontAttributes="Bold" Padding="16,8"/>
                        </Grid>
                        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0"/>
                            <ActivityIndicator Grid.Column="1" IsRunning="{Binding UserMgmtLoading}"
                                               IsVisible="{Binding UserMgmtLoading}" Color="SteelBlue" VerticalOptions="Center"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Reset Password section -->
                <Border Grid.Row="2" Padding="14,12" Stroke="#555" StrokeShape="RoundRectangle 6">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                        <Label Grid.Row="0" Text="Reset Password" FontAttributes="Bold" FontSize="14" TextColor="#CCCCCC"/>
                        <Grid Grid.Row="1" ColumnDefinitions="80,*,100,*,Auto,Auto,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="Username:"     VerticalOptions="Center" LineBreakMode="NoWrap"/>
                            <Entry Grid.Column="1" Text="{Binding ResetPwdUsername}" Placeholder="username"/>
                            <Label Grid.Column="2" Text="New Password:" VerticalOptions="Center" LineBreakMode="NoWrap"/>
                            <Entry Grid.Column="3" Text="{Binding ResetPwdPassword}" IsPassword="True" Placeholder="new password"/>
                            <CheckBox Grid.Column="4" IsChecked="{Binding ResetPwdMustChange}" VerticalOptions="Center"/>
                            <Label Grid.Column="5" Text="Must change at next logon" VerticalOptions="Center" FontSize="12"/>
                            <Button Grid.Column="6" Text="Reset Password" Command="{Binding ResetPasswordCommand}"
                                    BackgroundColor="#CC4400" TextColor="White" FontAttributes="Bold" Padding="16,8"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Status -->
                <Border Grid.Row="3" Padding="12,8" StrokeShape="RoundRectangle 4"
                        BackgroundColor="{Binding UserMgmtStatusColor}" Stroke="#444"
                        IsVisible="{Binding UserMgmtStatusVisible}" MaximumHeightRequest="120">
                    <ScrollView>
                        <Label Text="{Binding UserMgmtStatusText}" FontSize="12" TextColor="White" LineBreakMode="WordWrap"/>
                    </ScrollView>
                </Border>

                <!-- Existing local users list -->
                <Grid Grid.Row="4" RowDefinitions="Auto,*" RowSpacing="6">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Local Users on Target" FontSize="12" TextColor="Gray" VerticalOptions="Center"/>
                        <Button Grid.Column="1" Text="Refresh List" Command="{Binding LoadUsersMgmtCommand}"
                                BackgroundColor="#333" TextColor="White" FontSize="11" Padding="10,4"/>
                    </Grid>
                    <Border Grid.Row="1" Stroke="LightGray" StrokeShape="RoundRectangle 4"
                            MaximumHeightRequest="220">
                        <ScrollView>
                            <CollectionView ItemsSource="{Binding LocalUsersMgmt}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="140,80,*" ColumnSpacing="8" Padding="12,6">
                                            <Label Grid.Column="0" Text="{Binding Name}"        FontSize="12" FontAttributes="Bold"/>
                                            <Label Grid.Column="1" Text="{Binding Enabled}"     FontSize="12" TextColor="{Binding EnabledColor}"/>
                                            <Label Grid.Column="2" Text="{Binding Description}" FontSize="12" TextColor="Gray"/>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </ScrollView>
                    </Border>
                </Grid>
            </Grid>

            <!-- â”€â”€ DNS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelDns" RowDefinitions="Auto,*" RowSpacing="8"
                  Padding="4" IsVisible="False">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0" Text="{Binding DnsQuery}" Placeholder="hostname or IP to look up"/>
                    <Button Grid.Column="1" Text="Lookup" Command="{Binding DnsLookupCommand}"
                            BackgroundColor="SteelBlue" Padding="14,8"/>
                    <Button Grid.Column="2" Text="Flush Cache" Command="{Binding DnsFlushCommand}"
                            BackgroundColor="#1565C0" Padding="14,8"/>
                    <ActivityIndicator Grid.Column="3" IsRunning="{Binding DnsLoading}"
                                       IsVisible="{Binding DnsLoading}" Color="SteelBlue"
                                       VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="1" Padding="14,10" StrokeShape="RoundRectangle 6"
                        BackgroundColor="#1A1A1A" Stroke="#333">
                    <Label Text="{Binding DnsOutput}" FontFamily="Courier New" FontSize="12"
                           TextColor="#00FF41"/>
                </Border>
            </Grid>

            <!-- â”€â”€ Remote Registry â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelRegistry" RowDefinitions="Auto,Auto,*" RowSpacing="8"
                  Padding="4" IsVisible="False">
                <Grid Grid.Row="0" ColumnDefinitions="70,160,140,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0" Text="{Binding RegHive}" Placeholder="HKLM"/>
                    <Entry Grid.Column="1" Text="{Binding RegKey}" Placeholder="SOFTWARE\Microsoft\Windows"/>
                    <Entry Grid.Column="2" Text="{Binding RegValueName}" Placeholder="ValueName"/>
                    <Button Grid.Column="3" Text="Get" Command="{Binding RegGetCommand}"
                            BackgroundColor="SteelBlue" Padding="14,8"/>
                    <Button Grid.Column="4" Text="Set" Command="{Binding RegSetCommand}"
                            BackgroundColor="#228B22" Padding="14,8"/>
                    <Button Grid.Column="5" Text="Delete" Command="{Binding RegDeleteCommand}"
                            BackgroundColor="#CC4400" Padding="14,8"/>
                    <ActivityIndicator Grid.Column="6" IsRunning="{Binding RegistryLoading}"
                                       IsVisible="{Binding RegistryLoading}" Color="SteelBlue"
                                       VerticalOptions="Center"/>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="80,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Value Data:" VerticalOptions="Center" FontAttributes="Bold"/>
                    <Entry Grid.Column="1" Text="{Binding RegValueData}" Placeholder="data for Set operation"/>
                </Grid>
                <Border Grid.Row="2" StrokeShape="RoundRectangle 6" BackgroundColor="#1A1A1A" Stroke="#333">
                    <Editor Text="{Binding RegOutput}" FontFamily="Courier New" FontSize="12"
                            TextColor="#00FF41" BackgroundColor="Transparent"
                            IsReadOnly="True" AutoSize="TextChanges" MinimumHeightRequest="200"/>
                </Border>
            </Grid>

            <!-- â”€â”€ GP Update â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelGpUpdate" RowDefinitions="Auto,Auto,*" RowSpacing="8"
                  Padding="4" IsVisible="False">
                <Label Grid.Row="0"
                       Text="Forces an immediate Group Policy refresh on the target machine (or locally if no target is set)."
                       TextColor="Gray" FontSize="12"/>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Run gpupdate /force" Command="{Binding GpUpdateCommand}"
                            BackgroundColor="#1565C0" TextColor="White" FontAttributes="Bold" Padding="18,10"/>
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding GpUpdateLoading}"
                                       IsVisible="{Binding GpUpdateLoading}" Color="SteelBlue"
                                       HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="2" Padding="14,10" StrokeShape="RoundRectangle 6"
                        BackgroundColor="#1A1A1A" Stroke="#333">
                    <Label Text="{Binding GpUpdateOutput}" FontFamily="Courier New" FontSize="12"
                           TextColor="#00FF41"/>
                </Border>
            </Grid>

            <!-- â”€â”€ Copy File â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelCopyFile" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="8"
                  Padding="4" IsVisible="False">
                <Grid Grid.Row="0" ColumnDefinitions="60,100,80,*,80,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Domain:" VerticalOptions="Center"/>
                    <Entry Grid.Column="1" Text="{Binding CopyDomain}" Placeholder="."/>
                    <Label Grid.Column="2" Text="Username:" VerticalOptions="Center"/>
                    <Entry Grid.Column="3" Text="{Binding CopyUsername}" Placeholder="admin"/>
                    <Label Grid.Column="4" Text="Password:" VerticalOptions="Center"/>
                    <Entry Grid.Column="5" Text="{Binding CopyPassword}" IsPassword="True"/>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0" Text="{Binding CopyLocalPath}" Placeholder="Local file path"/>
                    <Button Grid.Column="1" Text="Browse" Command="{Binding CopyBrowseCommand}"
                            BackgroundColor="White" TextColor="Black" Padding="12,8"/>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0" Text="{Binding CopyRemoteDest}" Placeholder="C:\Windows\Temp"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding CopyCreateDir}" VerticalOptions="Center"/>
                    <Label Grid.Column="2" Text="Create dir if missing" VerticalOptions="Center" FontSize="12"/>
                </Grid>
                <Grid Grid.Row="3" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Copy File" Command="{Binding CopyRunCommand}"
                            BackgroundColor="#8B0000" TextColor="White" FontAttributes="Bold" Padding="18,10"/>
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding CopyLoading}"
                                       IsVisible="{Binding CopyLoading}" Color="SteelBlue"
                                       HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="4" Padding="10,8" StrokeShape="RoundRectangle 4"
                        BackgroundColor="#0D0D0D" Stroke="#333">
                    <CollectionView ItemsSource="{Binding CopyLog}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Label FontFamily="Courier New" FontSize="11" TextColor="#00FF41"
                                       Text="{Binding Message}" Padding="0,1"/>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </Grid>


            <!-- Winget Install -->
            <Grid x:Name="PanelWinget" RowDefinitions="Auto,Auto,*" RowSpacing="8" Padding="4" IsVisible="False">
                <Label Grid.Row="0" Text="Search for or install a package via winget on the target machine. Search first, then use the exact ID to install." TextColor="Gray" FontSize="12" LineBreakMode="WordWrap"/>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,*" ColumnSpacing="8">
                    <Entry Grid.Column="0" Text="{Binding WingetSearch}" Placeholder="package name or ID"/>
                    <Button Grid.Column="1" Text="Search" Command="{Binding WingetSearchCommand}"
                            BackgroundColor="SteelBlue" Padding="14,8"/>
                    <Button Grid.Column="2" Text="Install" Command="{Binding WingetInstallCommand}"
                            BackgroundColor="#228B22" TextColor="White" Padding="14,8"/>
                    <ActivityIndicator Grid.Column="3" IsRunning="{Binding WingetLoading}" IsVisible="{Binding WingetLoading}"
                                       Color="SteelBlue" HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="2" Stroke="LightGray" StrokeShape="RoundRectangle 4" Padding="10">
                    <ScrollView><Label Text="{Binding WingetOutput}" FontFamily="Courier New" FontSize="11" LineBreakMode="NoWrap"/></ScrollView>
                </Border>
            </Grid>

            <!-- Registry Push -->
            <Grid x:Name="PanelRegPush" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="8" Padding="4" IsVisible="False">
                <Label Grid.Row="0" Text="Read or write registry values on the target machine. Use full path e.g. HKLM:\SOFTWARE\MyApp" TextColor="Gray" FontSize="12" LineBreakMode="WordWrap"/>
                <Grid Grid.Row="1" ColumnDefinitions="60,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Path:" VerticalOptions="Center" FontAttributes="Bold"/>
                    <Entry Grid.Column="1" Text="{Binding RegPushPath}" Placeholder="HKLM:\SOFTWARE\Company\App"/>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="60,*,80,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Name:" VerticalOptions="Center" FontAttributes="Bold"/>
                    <Entry Grid.Column="1" Text="{Binding RegPushName}" Placeholder="ValueName"/>
                    <Label Grid.Column="2" Text="Type:" VerticalOptions="Center" FontAttributes="Bold"/>
                    <Picker Grid.Column="3" ItemsSource="{Binding RegTypes}" SelectedItem="{Binding RegPushType}"/>
                </Grid>
                <Grid Grid.Row="3" ColumnDefinitions="60,*,Auto,Auto,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Value:" VerticalOptions="Center" FontAttributes="Bold"/>
                    <Entry Grid.Column="1" Text="{Binding RegPushValue}" Placeholder="value data"/>
                    <Button Grid.Column="2" Text="Write" Command="{Binding RegPushCommand}"
                            BackgroundColor="#8B0000" TextColor="White" Padding="14,8"/>
                    <Button Grid.Column="3" Text="Read" Command="{Binding RegReadCommand}"
                            BackgroundColor="SteelBlue" Padding="14,8"/>
                    <ActivityIndicator Grid.Column="4" IsRunning="{Binding RegPushLoading}" IsVisible="{Binding RegPushLoading}"
                                       Color="SteelBlue" HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="4" Stroke="LightGray" StrokeShape="RoundRectangle 4" Padding="10">
                    <ScrollView><Label Text="{Binding RegPushOutput}" FontFamily="Courier New" FontSize="12"/></ScrollView>
                </Border>
            </Grid>

            <!-- Pending Updates -->
            <Grid x:Name="PanelPendingUpdates" RowDefinitions="Auto,Auto,*" RowSpacing="8" Padding="4" IsVisible="False">
                <Label Grid.Row="0" Text="Queries Windows Update for updates that are available but not yet installed. May take 30-60 seconds on first run." TextColor="Gray" FontSize="12" LineBreakMode="WordWrap"/>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Check for Pending Updates" Command="{Binding CheckPendingUpdatesCommand}"
                            BackgroundColor="#0078D4" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding PendingUpdatesLoading}" IsVisible="{Binding PendingUpdatesLoading}"
                                       Color="#0078D4" HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="2" Stroke="LightGray" StrokeShape="RoundRectangle 4" Padding="10">
                    <ScrollView><Label Text="{Binding PendingUpdatesOutput}" FontFamily="Courier New" FontSize="12"/></ScrollView>
                </Border>
            </Grid>

            <!-- Run Updates -->
            <Grid x:Name="PanelRunUpdates" RowDefinitions="Auto,Auto,*" RowSpacing="8" Padding="4" IsVisible="False">
                <Label Grid.Row="0" Text="Trigger Windows Update stages on the target. Scan first, then Download, then Install. Install may cause a reboot." TextColor="Gray" FontSize="12" LineBreakMode="WordWrap"/>
                <HorizontalStackLayout Grid.Row="1" Spacing="8">
                    <Button Text="1. Scan" Command="{Binding UpdateScanCommand}"
                            BackgroundColor="SteelBlue" Padding="16,8"/>
                    <Button Text="2. Download" Command="{Binding UpdateDownloadCommand}"
                            BackgroundColor="#CC7700" TextColor="White" Padding="16,8"/>
                    <Button Text="3. Install" Command="{Binding UpdateInstallCommand}"
                            BackgroundColor="#8B0000" TextColor="White" Padding="16,8"/>
                    <ActivityIndicator IsRunning="{Binding RunUpdatesLoading}" IsVisible="{Binding RunUpdatesLoading}"
                                       Color="SteelBlue" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <Border Grid.Row="2" Stroke="LightGray" StrokeShape="RoundRectangle 4" Padding="10">
                    <ScrollView><Label Text="{Binding RunUpdatesOutput}" FontFamily="Courier New" FontSize="12"/></ScrollView>
                </Border>
            </Grid>

            <!-- Update Log -->
            <Grid x:Name="PanelUpdateLog" RowDefinitions="Auto,Auto,*" RowSpacing="8" Padding="4" IsVisible="False">
                <Label Grid.Row="0" Text="Shows the last 50 Windows Update events from the System event log, newest first." TextColor="Gray" FontSize="12"/>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Load Update Log" Command="{Binding LoadUpdateLogCommand}"
                            BackgroundColor="SteelBlue" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding UpdateLogLoading}" IsVisible="{Binding UpdateLogLoading}"
                                       Color="SteelBlue" HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="2" Stroke="LightGray" StrokeShape="RoundRectangle 4" Padding="10">
                    <ScrollView><Label Text="{Binding UpdateLogOutput}" FontFamily="Courier New" FontSize="11" LineBreakMode="NoWrap"/></ScrollView>
                </Border>
            </Grid>

            <!-- â”€â”€ Scheduled Tasks â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelSchedTasks" RowDefinitions="Auto,Auto,*" RowSpacing="8" Padding="4" IsVisible="False">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Load Tasks" Command="{Binding LoadSchedTasksCommand}"
                            BackgroundColor="SteelBlue" Padding="16,8"/>
                    <Button Grid.Column="1" Text="Run" Command="{Binding RunSchedTaskCommand}"
                            BackgroundColor="#228B22" Padding="14,8"/>
                    <Button Grid.Column="2" Text="Enable" Command="{Binding EnableSchedTaskCommand}"
                            BackgroundColor="#1565C0" Padding="14,8"/>
                    <Button Grid.Column="3" Text="Disable" Command="{Binding DisableSchedTaskCommand}"
                            BackgroundColor="#CC4400" Padding="14,8"/>
                    <ActivityIndicator Grid.Column="4" IsRunning="{Binding SchedTasksLoading}"
                                       IsVisible="{Binding SchedTasksLoading}" Color="SteelBlue" VerticalOptions="Center"/>
                    <Label Grid.Column="5" Text="{Binding SelectedSchedTask.TaskName, StringFormat='Selected: {0}'}"
                           VerticalOptions="Center" TextColor="Gray" FontSize="12"/>
                </Grid>
                <Border Grid.Row="1" Stroke="LightGray" StrokeThickness="1" StrokeShape="RoundRectangle 4">
                    <CollectionView ItemsSource="{Binding SchedTasks}" SelectionMode="Single"
                                    SelectedItem="{Binding SelectedSchedTask}">
                        <CollectionView.Header>
                            <Grid ColumnDefinitions="*,90,130,130,150" Padding="8,6" BackgroundColor="#F5F5F5" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="Task Name" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="1" Text="Status" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="2" Text="Last Run" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="3" Text="Next Run" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="4" Text="Author" FontAttributes="Bold" FontSize="12"/>
                            </Grid>
                        </CollectionView.Header>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,90,130,130,150" Padding="8,5" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding TaskName}" FontSize="12"/>
                                    <Label Grid.Column="1" Text="{Binding Status}" FontSize="12" TextColor="{Binding StatusColor}"/>
                                    <Label Grid.Column="2" Text="{Binding LastRun}" FontSize="11" TextColor="Gray"/>
                                    <Label Grid.Column="3" Text="{Binding NextRun}" FontSize="11" TextColor="Gray"/>
                                    <Label Grid.Column="4" Text="{Binding Author}" FontSize="11" TextColor="Gray"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </Grid>

            <!-- â”€â”€ Windows Activation â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelActivation" RowDefinitions="Auto,*" RowSpacing="8" Padding="4" IsVisible="False">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Check Activation" Command="{Binding CheckActivationCommand}"
                            BackgroundColor="SteelBlue" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding ActivationLoading}"
                                       IsVisible="{Binding ActivationLoading}" Color="SteelBlue"
                                       HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="1" Padding="14,10" StrokeShape="RoundRectangle 6" BackgroundColor="#1A1A1A" Stroke="#333">
                    <ScrollView>
                        <Label Text="{Binding ActivationOutput}" FontFamily="Courier New" FontSize="12" TextColor="#00FF41"/>
                    </ScrollView>
                </Border>
            </Grid>

            <!-- â”€â”€ Temp Cleanup â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelTempClean" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8" Padding="4" IsVisible="False">
                <!-- Credentials row -->
                <Grid Grid.Row="0" ColumnDefinitions="60,100,80,*,80,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Domain:" VerticalOptions="Center"/>
                    <Entry Grid.Column="1" Text="{Binding TempCleanDomain}" Placeholder="."/>
                    <Label Grid.Column="2" Text="Username:" VerticalOptions="Center"/>
                    <Entry Grid.Column="3" Text="{Binding TempCleanUsername}" Placeholder="admin (blank = current user)"/>
                    <Label Grid.Column="4" Text="Password:" VerticalOptions="Center"/>
                    <Entry Grid.Column="5" Text="{Binding TempCleanPassword}" IsPassword="True"/>
                </Grid>
                <!-- Action buttons row -->
                <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Scan" Command="{Binding TempCleanScanCommand}"
                            BackgroundColor="SteelBlue" Padding="16,8"/>
                    <Button Grid.Column="1" Text="Clean Now" Command="{Binding TempCleanRunCommand}"
                            BackgroundColor="#CC4400" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="2" IsRunning="{Binding TempCleanLoading}"
                                       IsVisible="{Binding TempCleanLoading}" Color="SteelBlue"
                                       HorizontalOptions="Start" VerticalOptions="Center"/>
                    <Label Grid.Column="3" Text="Cleans: C:\Windows\Temp and Prefetch"
                           VerticalOptions="Center" TextColor="Gray" FontSize="12"/>
                </Grid>
                <!-- Folder browser row -->
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Browse folder:" VerticalOptions="Center" FontAttributes="Bold"/>
                    <Picker Grid.Column="1" ItemsSource="{Binding TempCleanFolders}"
                            SelectedItem="{Binding TempCleanSelectedFolder}" VerticalOptions="Center"/>
                    <Button Grid.Column="2" Text="List Files" Command="{Binding TempCleanListCommand}"
                            BackgroundColor="#1565C0" Padding="16,8"/>
                </Grid>
                <!-- Output -->
                <Border Grid.Row="3" Padding="14,10" StrokeShape="RoundRectangle 6" BackgroundColor="#1A1A1A" Stroke="#333">
                    <ScrollView>
                        <Label Text="{Binding TempCleanOutput}" FontFamily="Courier New" FontSize="12" TextColor="#00FF41"/>
                    </ScrollView>
                </Border>
            </Grid>

            <!-- â”€â”€ Startup Programs â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelStartup" RowDefinitions="Auto,*" RowSpacing="8" Padding="4" IsVisible="False">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Load Startup Programs" Command="{Binding LoadStartupCommand}"
                            BackgroundColor="SteelBlue" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding StartupLoading}"
                                       IsVisible="{Binding StartupLoading}" Color="SteelBlue"
                                       HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="1" Stroke="LightGray" StrokeThickness="1" StrokeShape="RoundRectangle 4">
                    <CollectionView ItemsSource="{Binding StartupItems}">
                        <CollectionView.Header>
                            <Grid ColumnDefinitions="160,*,160" Padding="8,6" BackgroundColor="#F5F5F5" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="Name" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="1" Text="Command / Path" FontAttributes="Bold" FontSize="12"/>
                                <Label Grid.Column="2" Text="Location" FontAttributes="Bold" FontSize="12"/>
                            </Grid>
                        </CollectionView.Header>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="160,*,160" Padding="8,5" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding Name}" FontSize="12" FontAttributes="Bold"/>
                                    <Label Grid.Column="1" Text="{Binding Command}" FontSize="11" TextColor="Gray"/>
                                    <Label Grid.Column="2" Text="{Binding Location}" FontSize="11" TextColor="#1565C0"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </Grid>

            <!-- â”€â”€ Remote PowerShell â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelRemotePs" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12"
                  Padding="4" IsVisible="False">
                <Border Grid.Row="0" Padding="12,10" BackgroundColor="#FFF8E1" Stroke="#FFB300"
                        StrokeShape="RoundRectangle 4">
                    <Label FontSize="12" TextColor="#5D4037">
                        <Label.Text>Opens a new PowerShell console window and connects to the target computer via Enter-PSSession. Admin credentials are required. The session runs interactively in the console â€” close it when done.</Label.Text>
                    </Label>
                </Border>
                <Grid Grid.Row="1" ColumnDefinitions="60,120,80,*,80,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Domain:" VerticalOptions="Center"/>
                    <Entry Grid.Column="1" Text="{Binding RemotePsDomain}" Placeholder=". or DOMAIN"/>
                    <Label Grid.Column="2" Text="Username:" VerticalOptions="Center"/>
                    <Entry Grid.Column="3" Text="{Binding RemotePsUsername}" Placeholder="admin username"/>
                    <Label Grid.Column="4" Text="Password:" VerticalOptions="Center"/>
                    <Entry Grid.Column="5" Text="{Binding RemotePsPassword}" IsPassword="True"/>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Button Grid.Column="0" Text="Connect Remote PS" Command="{Binding ConnectRemotePsCommand}"
                            BackgroundColor="#1565C0" TextColor="White" FontAttributes="Bold" Padding="20,10"/>
                    <Label Grid.Column="1" Text="{Binding RemotePsStatus}" VerticalOptions="Center"
                           TextColor="#228B22" FontSize="12"/>
                </Grid>
            </Grid>

            <!-- â”€â”€ PS Runner â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelPsRun" RowDefinitions="Auto,*,Auto,200" RowSpacing="10"
                  Padding="4" IsVisible="False">
                <!-- Creds row -->
                <Grid Grid.Row="0" ColumnDefinitions="60,120,80,*,80,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Domain:" VerticalOptions="Center"/>
                    <Entry Grid.Column="1" Text="{Binding PsRunDomain}" Placeholder=". or DOMAIN"/>
                    <Label Grid.Column="2" Text="Username:" VerticalOptions="Center"/>
                    <Entry Grid.Column="3" Text="{Binding PsRunUsername}" Placeholder="admin username"/>
                    <Label Grid.Column="4" Text="Password:" VerticalOptions="Center"/>
                    <Entry Grid.Column="5" Text="{Binding PsRunPassword}" IsPassword="True"/>
                </Grid>
                <!-- Script editor -->
                <Border Grid.Row="1" Stroke="#444" StrokeShape="RoundRectangle 4" Padding="2">
                    <Editor x:Name="PsRunEditor" Text="{Binding PsRunScript}"
                            Placeholder="Paste or type PowerShell here â€” runs on the remote machine via Invoke-Command"
                            FontFamily="Consolas" FontSize="13" BackgroundColor="#1E1E1E"
                            TextColor="White" AutoSize="TextChanges"/>
                </Border>
                <!-- Run button row -->
                <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                    <Button Grid.Column="0" Text="Run on Remote" Command="{Binding RunPsOnRemoteCommand}"
                            BackgroundColor="#1565C0" TextColor="White" FontAttributes="Bold" Padding="20,10"/>
                    <Button Grid.Column="1" Text="Clear" Command="{Binding ClearPsRunCommand}"
                            BackgroundColor="White" TextColor="Black" Padding="14,10"/>
                    <Label  Grid.Column="2" Text="{Binding PsRunStatus}" VerticalOptions="Center"
                            TextColor="#228B22" FontSize="12"/>
                </Grid>
                <!-- Output -->
                <Border Grid.Row="3" Stroke="#444" StrokeShape="RoundRectangle 4" Padding="8">
                    <ScrollView>
                        <Label Text="{Binding PsRunOutput}" FontFamily="Consolas" FontSize="12"
                               TextColor="#D4D4D4" BackgroundColor="#1E1E1E" LineBreakMode="CharacterWrap"/>
                    </ScrollView>
                </Border>
            </Grid>

            <!-- â”€â”€ Remote Directory Browser â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelDirBrowser" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10"
                  Padding="4" IsVisible="False">
                <!-- Credentials -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="6">
                    <Label Grid.Column="0" Text="Domain:" VerticalOptions="Center" LineBreakMode="NoWrap"/>
                    <Entry Grid.Column="1" Text="{Binding DirDomain}" Placeholder="domain or ."/>
                    <Label Grid.Column="2" Text="Username:" VerticalOptions="Center" LineBreakMode="NoWrap"/>
                    <Entry Grid.Column="3" Text="{Binding DirUsername}" Placeholder="username"/>
                    <Label Grid.Column="4" Text="Password:" VerticalOptions="Center" LineBreakMode="NoWrap"/>
                    <Entry Grid.Column="5" Text="{Binding DirPassword}" IsPassword="True" Placeholder="password"/>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Scan Shares" Command="{Binding ScanSharesCommand}"
                            BackgroundColor="SteelBlue" Padding="14,8"/>
                    <Picker Grid.Column="1" ItemsSource="{Binding DirShares}"
                            SelectedItem="{Binding DirSelectedShare}" Title="Select a share..."/>
                    <Entry Grid.Column="2" Text="{Binding DirSubfolder}" Placeholder="subfolder (optional)"
                           WidthRequest="200"/>
                    <Button Grid.Column="3" Text="List" Command="{Binding DirListCommand}"
                            BackgroundColor="#228B22" Padding="14,8"/>
                    <ActivityIndicator Grid.Column="4" IsRunning="{Binding DirLoading}"
                                       IsVisible="{Binding DirLoading}" Color="SteelBlue" VerticalOptions="Center"/>
                </Grid>
                <Label Grid.Row="2" Text="{Binding DirStatus}" FontSize="12" TextColor="Gray"/>
                <Border Grid.Row="3" Stroke="#444" StrokeThickness="1" StrokeShape="RoundRectangle 4" Padding="8">
                    <ScrollView>
                        <Label Text="{Binding DirOutput}" FontFamily="Consolas" FontSize="12"
                               TextColor="#D4D4D4" BackgroundColor="#1E1E1E" LineBreakMode="CharacterWrap"/>
                    </ScrollView>
                </Border>
            </Grid>

            <!-- â”€â”€ Remote Process Kill â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelProcKill" RowDefinitions="Auto,Auto,*" RowSpacing="10"
                  Padding="4" IsVisible="False">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0" Text="{Binding ProcKillSearch}" Placeholder="Filter by process name..."/>
                    <Button Grid.Column="1" Text="Refresh" Command="{Binding LoadProcKillCommand}"
                            BackgroundColor="SteelBlue" Padding="14,8"/>
                    <Button Grid.Column="2" Text="Kill Selected" Command="{Binding KillRemoteProcCommand}"
                            BackgroundColor="#CC2200" Padding="14,8"/>
                    <ActivityIndicator Grid.Column="3" IsRunning="{Binding ProcKillLoading}"
                                       IsVisible="{Binding ProcKillLoading}" Color="SteelBlue" VerticalOptions="Center"/>
                </Grid>
                <Label Grid.Row="1" Text="{Binding ProcKillStatus}" FontSize="12" TextColor="#228B22"/>
                <Border Grid.Row="2" Stroke="LightGray" StrokeShape="RoundRectangle 4">
                    <CollectionView ItemsSource="{Binding RemoteProcesses}" SelectionMode="Single"
                                    SelectedItem="{Binding ProcKillSelected}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="60,200,80,*" ColumnSpacing="8" Padding="12,5">
                                    <Label Grid.Column="0" Text="{Binding Pid}"     FontSize="12" FontAttributes="Bold"/>
                                    <Label Grid.Column="1" Text="{Binding Name}"    FontSize="12"/>
                                    <Label Grid.Column="2" Text="{Binding CpuPct}"  FontSize="12" TextColor="Gray"/>
                                    <Label Grid.Column="3" Text="{Binding MemMb}"   FontSize="12" TextColor="Gray"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </Grid>

            <!-- â”€â”€ WinRM Toggle â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelWinRmToggle" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="12"
                  Padding="4" IsVisible="False">
                <Border Grid.Row="0" Padding="12,10" BackgroundColor="#FFF8E1" Stroke="#FFB300"
                        StrokeShape="RoundRectangle 4">
                    <Label FontSize="12" TextColor="#5D4037" LineBreakMode="WordWrap"
                           Text="Enabling WinRM allows remote PowerShell on the target. Requires admin rights and runs Enable-PSRemoting. Disable will stop the WinRM service and remove firewall rules."/>
                </Border>
                <!-- Credentials -->
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="6">
                    <Label Grid.Column="0" Text="Domain:" VerticalOptions="Center" LineBreakMode="NoWrap"/>
                    <Entry Grid.Column="1" Text="{Binding WinRmDomain}" Placeholder="domain or ."/>
                    <Label Grid.Column="2" Text="Username:" VerticalOptions="Center" LineBreakMode="NoWrap"/>
                    <Entry Grid.Column="3" Text="{Binding WinRmUsername}" Placeholder="username"/>
                    <Label Grid.Column="4" Text="Password:" VerticalOptions="Center" LineBreakMode="NoWrap"/>
                    <Entry Grid.Column="5" Text="{Binding WinRmPassword}" IsPassword="True" Placeholder="password"/>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12">
                    <Button Grid.Column="0" Text="Check Status" Command="{Binding WinRmCheckCommand}"
                            BackgroundColor="SteelBlue" Padding="14,8"/>
                    <Button Grid.Column="1" Text="Enable WinRM" Command="{Binding WinRmEnableCommand}"
                            BackgroundColor="#228B22" Padding="14,8"/>
                    <Button Grid.Column="2" Text="Disable WinRM" Command="{Binding WinRmDisableCommand}"
                            BackgroundColor="#CC2200" Padding="14,8"/>
                    <ActivityIndicator Grid.Column="3" IsRunning="{Binding WinRmLoading}"
                                       IsVisible="{Binding WinRmLoading}" Color="SteelBlue" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="3" Padding="12,10" StrokeShape="RoundRectangle 4"
                        BackgroundColor="{Binding WinRmStatusColor}" Stroke="#444"
                        IsVisible="{Binding WinRmStatusVisible}">
                    <Label Text="{Binding WinRmStatusText}" FontAttributes="Bold" TextColor="White"/>
                </Border>
                <Border Grid.Row="4" Stroke="#444" StrokeShape="RoundRectangle 4" Padding="10">
                    <ScrollView>
                        <Label Text="{Binding WinRmOutput}" FontFamily="Consolas" FontSize="12"
                               TextColor="#D4D4D4" BackgroundColor="#1E1E1E" LineBreakMode="CharacterWrap"/>
                    </ScrollView>
                </Border>
            </Grid>

            <!-- â”€â”€ Wake on LAN â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelWakeOnLan" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12"
                  Padding="4" IsVisible="False">
                <Border Grid.Row="0" Padding="12,10" BackgroundColor="#E8F5E9" Stroke="#388E3C"
                        StrokeShape="RoundRectangle 4">
                    <Label FontSize="12" TextColor="#1B5E20" LineBreakMode="WordWrap"
                           Text="Sends a Wake-on-LAN magic packet to the target MAC address. The machine must have WoL enabled in BIOS and the network adapter must support it. Use the broadcast address of the target subnet."/>
                </Border>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,*,Auto,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="MAC Address:" VerticalOptions="Center" LineBreakMode="NoWrap"/>
                    <Entry Grid.Column="1" Text="{Binding WolMac}" Placeholder="AA:BB:CC:DD:EE:FF"/>
                    <Label Grid.Column="2" Text="Broadcast IP:" VerticalOptions="Center" LineBreakMode="NoWrap"/>
                    <Entry Grid.Column="3" Text="{Binding WolBroadcast}" Placeholder="192.168.1.255"/>
                    <Button Grid.Column="4" Text="Wake!" Command="{Binding WakeOnLanCommand}"
                            BackgroundColor="#228B22" FontAttributes="Bold" Padding="20,8"/>
                    <ActivityIndicator Grid.Column="5" IsRunning="{Binding WolLoading}"
                                       IsVisible="{Binding WolLoading}" Color="SteelBlue" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="2" Padding="12,10" StrokeShape="RoundRectangle 4"
                        BackgroundColor="{Binding WolStatusColor}" Stroke="#444"
                        IsVisible="{Binding WolStatusVisible}">
                    <Label Text="{Binding WolStatusText}" FontAttributes="Bold" TextColor="White"/>
                </Border>
                <!-- Recent WoL history -->
                <Border Grid.Row="3" Stroke="LightGray" StrokeShape="RoundRectangle 4" Padding="10">
                    <ScrollView>
                        <Label Text="{Binding WolHistory}" FontFamily="Consolas" FontSize="12"
                               LineBreakMode="CharacterWrap"/>
                    </ScrollView>
                </Border>
            </Grid>

            <!-- â”€â”€ Flush DNS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelFlushDns" RowDefinitions="Auto,Auto,*" RowSpacing="8" Padding="4" IsVisible="False">
                <Label Grid.Row="0" Text="Flushes the DNS resolver cache on the target machine. Fixes many name resolution issues." TextColor="Gray" FontSize="12"/>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Flush DNS Cache" Command="{Binding FlushDnsCommand}"
                            BackgroundColor="#0078D4" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding FlushDnsLoading}"
                                       IsVisible="{Binding FlushDnsLoading}" Color="#0078D4"
                                       HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="2" Stroke="LightGray" StrokeShape="RoundRectangle 4" Padding="10">
                    <ScrollView><Label Text="{Binding FlushDnsOutput}" FontFamily="Courier New" FontSize="12" LineBreakMode="NoWrap"/></ScrollView>
                </Border>
            </Grid>

            <!-- â”€â”€ NetStat â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelNetStat" RowDefinitions="Auto,Auto,*" RowSpacing="8" Padding="4" IsVisible="False">
                <Label Grid.Row="0" Text="Shows active TCP/UDP connections and listening ports (netstat -ano)." TextColor="Gray" FontSize="12"/>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Run NetStat" Command="{Binding NetStatCommand}"
                            BackgroundColor="#0078D4" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding NetStatLoading}"
                                       IsVisible="{Binding NetStatLoading}" Color="#0078D4"
                                       HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="2" Stroke="LightGray" StrokeShape="RoundRectangle 4" Padding="10">
                    <ScrollView><Label Text="{Binding NetStatOutput}" FontFamily="Courier New" FontSize="11" LineBreakMode="NoWrap"/></ScrollView>
                </Border>
            </Grid>

            <!-- â”€â”€ Traceroute â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelTrace" RowDefinitions="Auto,Auto,*" RowSpacing="8" Padding="4" IsVisible="False">
                <Label Grid.Row="0" Text="Traces the network path to a host (tracert -d -h 20). May take up to 60 seconds." TextColor="Gray" FontSize="12"/>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
                    <Entry Grid.Column="0" Text="{Binding TraceTarget}" Placeholder="hostname or IP to trace"/>
                    <Button Grid.Column="1" Text="Trace" Command="{Binding TraceRouteCommand}"
                            BackgroundColor="#0078D4" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="2" IsRunning="{Binding TraceLoading}"
                                       IsVisible="{Binding TraceLoading}" Color="#0078D4"
                                       HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="2" Stroke="LightGray" StrokeShape="RoundRectangle 4" Padding="10">
                    <ScrollView><Label Text="{Binding TraceOutput}" FontFamily="Courier New" FontSize="12" LineBreakMode="NoWrap"/></ScrollView>
                </Border>
            </Grid>

            <!-- â”€â”€ WiFi Profiles â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelWifi" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8" Padding="4" IsVisible="False">
                <Label Grid.Row="0" Text="Lists saved WiFi profiles. Works on local machine only." TextColor="Gray" FontSize="12"/>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Load WiFi Profiles" Command="{Binding LoadWifiCommand}"
                            BackgroundColor="#0078D4" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding WifiLoading}"
                                       IsVisible="{Binding WifiLoading}" Color="#0078D4"
                                       HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                    <Picker Grid.Column="0" ItemsSource="{Binding WifiProfileNames}"
                            SelectedItem="{Binding SelectedWifiProfile}" Title="Select profile to connect..."/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding WifiAutoConnect}" VerticalOptions="Center"/>
                    <Label Grid.Column="2" Text="Auto" VerticalOptions="Center" FontSize="12"/>
                    <Button Grid.Column="3" Text="Connect" Command="{Binding ConnectWifiCommand}"
                            BackgroundColor="#228B22" TextColor="White" Padding="14,8"/>
                </Grid>
                <Border Grid.Row="3" Stroke="LightGray" StrokeShape="RoundRectangle 4" Padding="10">
                    <ScrollView><Label Text="{Binding WifiOutput}" FontFamily="Courier New" FontSize="12" LineBreakMode="NoWrap"/></ScrollView>
                </Border>
            </Grid>

            <!-- â”€â”€ Proxy Settings â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelProxy" RowDefinitions="Auto,Auto,*" RowSpacing="8" Padding="4" IsVisible="False">
                <Label Grid.Row="0" Text="Reads current WinInet proxy settings from the user registry (HKCU)." TextColor="Gray" FontSize="12"/>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Read Proxy Settings" Command="{Binding LoadProxyCommand}"
                            BackgroundColor="#0078D4" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding ProxyLoading}"
                                       IsVisible="{Binding ProxyLoading}" Color="#0078D4"
                                       HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="2" Stroke="LightGray" StrokeShape="RoundRectangle 4" Padding="10">
                    <ScrollView><Label Text="{Binding ProxyOutput}" FontFamily="Courier New" FontSize="13"/></ScrollView>
                </Border>
            </Grid>

            <!-- â”€â”€ Reset NIC â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelResetNic" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8" Padding="4" IsVisible="False">
                <Label Grid.Row="0" Text="Disables then re-enables the selected adapter. Connection drops for ~5 seconds. Fixes many driver/DHCP issues." TextColor="Gray" FontSize="12"/>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Load Adapters" Command="{Binding LoadNicsCommand}"
                            BackgroundColor="SteelBlue" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding ResetNicLoading}"
                                       IsVisible="{Binding ResetNicLoading}" Color="SteelBlue"
                                       HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Picker Grid.Column="0" ItemsSource="{Binding NicList}" SelectedItem="{Binding SelectedNic}"
                            Title="Select adapter..."/>
                    <Button Grid.Column="1" Text="Reset Adapter" Command="{Binding ResetNicCommand}"
                            BackgroundColor="#8B0000" TextColor="White" Padding="16,8"/>
                </Grid>
                <Border Grid.Row="3" Stroke="LightGray" StrokeShape="RoundRectangle 4" Padding="10">
                    <ScrollView><Label Text="{Binding ResetNicOutput}" FontFamily="Courier New" FontSize="12"/></ScrollView>
                </Border>
            </Grid>

            <!-- Ping -->
            <Grid x:Name="PanelPing" RowDefinitions="Auto,Auto,*" RowSpacing="8" Padding="4" IsVisible="False">
                <Label Grid.Row="0" Text="Issues a ping FROM the target machine to any host or IP." TextColor="Gray" FontSize="12"/>
                <Grid Grid.Row="1" ColumnDefinitions="*,80,Auto,*" ColumnSpacing="8">
                    <Entry Grid.Column="0" Text="{Binding PingTarget}" Placeholder="hostname or IP to ping"/>
                    <Entry Grid.Column="1" Text="{Binding PingCount}" Placeholder="4" Keyboard="Numeric"/>
                    <Button Grid.Column="2" Text="Ping" Command="{Binding PingCommand}" BackgroundColor="#0078D4" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="3" IsRunning="{Binding PingLoading}" IsVisible="{Binding PingLoading}"
                                       Color="#0078D4" HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="2" Stroke="LightGray" StrokeShape="RoundRectangle 4" Padding="10">
                    <ScrollView><Label Text="{Binding PingOutput}" FontFamily="Courier New" FontSize="12" LineBreakMode="NoWrap"/></ScrollView>
                </Border>
            </Grid>

            <!-- WiFi Setup -->
            <Grid x:Name="PanelWifiSetup" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="8" Padding="4" IsVisible="False">
                <Label Grid.Row="0" Text="Create and install a WiFi profile on the target machine." TextColor="Gray" FontSize="12"/>
                <Grid Grid.Row="1" ColumnDefinitions="90,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="SSID:" VerticalOptions="Center" FontAttributes="Bold"/>
                    <Entry Grid.Column="1" Text="{Binding WifiSetupSsid}" Placeholder="Network name"/>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="90,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Password:" VerticalOptions="Center" FontAttributes="Bold"/>
                    <Entry Grid.Column="1" Text="{Binding WifiSetupPassword}" IsPassword="True"/>
                </Grid>
                <Grid Grid.Row="3" ColumnDefinitions="90,*,Auto,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Security:" VerticalOptions="Center" FontAttributes="Bold"/>
                    <Picker Grid.Column="1" ItemsSource="{Binding WifiSecurityTypes}" SelectedItem="{Binding WifiSetupSecurity}"/>
                    <CheckBox Grid.Column="2" IsChecked="{Binding WifiSetupAutoConnect}" VerticalOptions="Center"/>
                    <Label Grid.Column="3" Text="Auto-connect" VerticalOptions="Center" FontSize="12"/>
                </Grid>
                <Grid Grid.Row="4" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Add Profile" Command="{Binding AddWifiProfileCommand}"
                            BackgroundColor="#228B22" TextColor="White" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding WifiSetupLoading}" IsVisible="{Binding WifiSetupLoading}"
                                       Color="#228B22" HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="5" Stroke="LightGray" StrokeShape="RoundRectangle 4" Padding="10">
                    <ScrollView><Label Text="{Binding WifiSetupOutput}" FontFamily="Courier New" FontSize="12"/></ScrollView>
                </Border>
            </Grid>

            <!-- DHCP Stats -->
            <Grid x:Name="PanelDhcpStats" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8" Padding="4" IsVisible="False">
                <Label Grid.Row="0" Text="Queries DHCP scope usage from one or more servers. Requires the DhcpServer PS module (Windows Server / RSAT)." TextColor="Gray" FontSize="12"/>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,60" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="DHCP Server(s):" VerticalOptions="Center" FontAttributes="Bold"/>
                    <Entry Grid.Column="1" Text="{Binding DhcpServers}" Placeholder="server1, server2  (blank = localhost)"/>
                    <Label Grid.Column="2" Text="Alert %:" VerticalOptions="Center"/>
                    <Entry Grid.Column="3" Text="{Binding DhcpAlertPct}" Placeholder="95" Keyboard="Numeric"/>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Load DHCP Stats" Command="{Binding LoadDhcpStatsCommand}" BackgroundColor="SteelBlue" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding DhcpLoading}" IsVisible="{Binding DhcpLoading}" Color="SteelBlue" HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="3" Stroke="LightGray" StrokeShape="RoundRectangle 4" Padding="10">
                    <ScrollView><Label Text="{Binding DhcpOutput}" FontFamily="Courier New" FontSize="12"/></ScrollView>
                </Border>
            </Grid>


            <!-- â”€â”€ Auto Logon â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelAutoLogon" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8" Padding="4" IsVisible="False">
                <Grid Grid.Row="0" ColumnDefinitions="80,*,80,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Username:" VerticalOptions="Center"/>
                    <Entry Grid.Column="1" Text="{Binding AutoLogonUsername}" Placeholder="DOMAIN\user or user"/>
                    <Label Grid.Column="2" Text="Count:" VerticalOptions="Center"/>
                    <Entry Grid.Column="3" Text="{Binding AutoLogonCount}" Placeholder="1" Keyboard="Numeric"/>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="80,*,80,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Password:" VerticalOptions="Center"/>
                    <Entry Grid.Column="1" Text="{Binding AutoLogonPassword}" IsPassword="True"/>
                    <Label Grid.Column="2" Text="Run Script:" VerticalOptions="Center"/>
                    <Entry Grid.Column="3" Text="{Binding AutoLogonScript}" Placeholder="C:\path\to\script.bat (optional)"/>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Enable Auto Logon" Command="{Binding AutoLogonEnableCommand}"
                            BackgroundColor="#228B22" Padding="16,8"/>
                    <Button Grid.Column="1" Text="Disable" Command="{Binding AutoLogonDisableCommand}"
                            BackgroundColor="#8B0000" Padding="16,8"/>
                    <Button Grid.Column="2" Text="Check Status" Command="{Binding AutoLogonCheckCommand}"
                            BackgroundColor="SteelBlue" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="3" IsRunning="{Binding AutoLogonLoading}"
                                       IsVisible="{Binding AutoLogonLoading}" Color="SteelBlue"
                                       HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="3" Padding="14,10" StrokeShape="RoundRectangle 6" BackgroundColor="#1A1A1A" Stroke="#333">
                    <ScrollView><Label Text="{Binding AutoLogonOutput}" FontFamily="Courier New" FontSize="12" TextColor="#00FF41"/></ScrollView>
                </Border>
            </Grid>

            <!-- â”€â”€ Default Printer â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelSetPrinter" RowDefinitions="Auto,*,Auto" RowSpacing="8" Padding="4" IsVisible="False">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Load Printers" Command="{Binding LoadPrintersForDefaultCommand}"
                            BackgroundColor="SteelBlue" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding SetPrinterLoading}"
                                       IsVisible="{Binding SetPrinterLoading}" Color="SteelBlue"
                                       HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="1" Stroke="LightGray" StrokeShape="RoundRectangle 4" Padding="4">
                    <ListView ItemsSource="{Binding PrinterNames}"
                              SelectedItem="{Binding SelectedPrinterName}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextCell Text="{Binding .}"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Set as Default" Command="{Binding SetDefaultPrinterCommand}"
                            BackgroundColor="#228B22" Padding="16,8"/>
                    <Label Grid.Column="1" Text="{Binding SetPrinterOutput}" VerticalOptions="Center" TextColor="#2E7D32"/>
                </Grid>
            </Grid>

            <!-- â”€â”€ Trusted Sites â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelTrustedSites" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8" Padding="4" IsVisible="False">
                <Label Grid.Row="0" Text="Manage IE/Edge Trusted Sites zone (HKCU registry) on the target machine."
                       TextColor="Gray" FontSize="12"/>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0" Text="{Binding TrustedSiteDomain}" Placeholder="e.g. contoso.com or intranet.local"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding TrustedSiteHttp}" VerticalOptions="Center"/>
                    <Label Grid.Column="2" Text="HTTP (default = HTTPS)" VerticalOptions="Center" FontSize="12"/>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Add Site" Command="{Binding AddTrustedSiteCommand}"
                            BackgroundColor="#228B22" Padding="16,8"/>
                    <Button Grid.Column="1" Text="Remove Site" Command="{Binding RemoveTrustedSiteCommand}"
                            BackgroundColor="#8B0000" Padding="16,8"/>
                    <Button Grid.Column="2" Text="List All" Command="{Binding ListTrustedSitesCommand}"
                            BackgroundColor="SteelBlue" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="3" IsRunning="{Binding TrustedSiteLoading}"
                                       IsVisible="{Binding TrustedSiteLoading}" Color="SteelBlue"
                                       HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="3" Padding="14,10" StrokeShape="RoundRectangle 6" BackgroundColor="#1A1A1A" Stroke="#333">
                    <ScrollView><Label Text="{Binding TrustedSiteOutput}" FontFamily="Courier New" FontSize="12" TextColor="#00FF41"/></ScrollView>
                </Border>
            </Grid>

            <!-- â”€â”€ Quick Access â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelQuickAccess" RowDefinitions="Auto,Auto,*" RowSpacing="8" Padding="4" IsVisible="False">
                <Label Grid.Row="0" Text="Pin or unpin folders from Quick Access in File Explorer. Runs on this machine (COM shell, local only)."
                       TextColor="Gray" FontSize="12"/>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0" Text="{Binding QuickAccessPath}" Placeholder="\\server\share or C:\path\to\folder"/>
                    <Button Grid.Column="1" Text="Browse" Command="{Binding QuickAccessBrowseCommand}"
                            BackgroundColor="White" TextColor="Black" Padding="14,8"/>
                    <Button Grid.Column="2" Text="Pin" Command="{Binding QuickAccessPinCommand}"
                            BackgroundColor="#228B22" Padding="16,8"/>
                    <Button Grid.Column="3" Text="Unpin" Command="{Binding QuickAccessUnpinCommand}"
                            BackgroundColor="#8B0000" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="4" IsRunning="{Binding QuickAccessLoading}"
                                       IsVisible="{Binding QuickAccessLoading}" Color="SteelBlue"
                                       HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="2" Padding="14,10" StrokeShape="RoundRectangle 6" BackgroundColor="#1A1A1A" Stroke="#333">
                    <ScrollView><Label Text="{Binding QuickAccessOutput}" FontFamily="Courier New" FontSize="12" TextColor="#00FF41"/></ScrollView>
                </Border>
            </Grid>

            <!-- â”€â”€ Windows Key â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelWinKey" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8" Padding="4" IsVisible="False">
                <Label Grid.Row="0" Text="Install a new Windows product key and activate via slmgr. Runs on the target machine."
                       TextColor="Gray" FontSize="12"/>
                <Grid Grid.Row="1" ColumnDefinitions="70,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Product Key:" VerticalOptions="Center" FontAttributes="Bold"/>
                    <Entry Grid.Column="1" Text="{Binding WinKeyValue}" Placeholder="XXXXX-XXXXX-XXXXX-XXXXX-XXXXX"
                           FontFamily="Courier New" MaxLength="29"/>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Install Key" Command="{Binding WinKeyInstallCommand}"
                            BackgroundColor="#228B22" Padding="16,8"/>
                    <Button Grid.Column="1" Text="Activate" Command="{Binding WinKeyActivateCommand}"
                            BackgroundColor="SteelBlue" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="2" IsRunning="{Binding WinKeyLoading}"
                                       IsVisible="{Binding WinKeyLoading}" Color="SteelBlue"
                                       HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="3" Padding="14,10" StrokeShape="RoundRectangle 6" BackgroundColor="#1A1A1A" Stroke="#333">
                    <ScrollView><Label Text="{Binding WinKeyOutput}" FontFamily="Courier New" FontSize="12" TextColor="#00FF41"/></ScrollView>
                </Border>
            </Grid>

            <!-- â”€â”€ WSUS Client â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelWsusClient" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="8" Padding="4" IsVisible="False">
                <Label Grid.Row="0" Text="Configure Windows Update Server (WSUS) client settings via registry. Runs on the target machine."
                       TextColor="Gray" FontSize="12"/>
                <Grid Grid.Row="1" ColumnDefinitions="80,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Server URL:" VerticalOptions="Center" FontAttributes="Bold"/>
                    <Entry Grid.Column="1" Text="{Binding WsusServerUrl}" Placeholder="http://wsus.contoso.com:8530"/>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="90,*,80,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Target Group:" VerticalOptions="Center"/>
                    <Entry Grid.Column="1" Text="{Binding WsusTargetGroup}" Placeholder="e.g. Workstations (optional)"/>
                    <Label Grid.Column="2" Text="AU Option:" VerticalOptions="Center"/>
                    <Picker Grid.Column="3" ItemsSource="{Binding WsusAuOptions}" SelectedItem="{Binding WsusAuOption}"/>
                </Grid>
                <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Apply WSUS" Command="{Binding WsusApplyCommand}"
                            BackgroundColor="#228B22" Padding="16,8"/>
                    <Button Grid.Column="1" Text="Disable WSUS" Command="{Binding WsusDisableCommand}"
                            BackgroundColor="#8B0000" Padding="16,8"/>
                    <Button Grid.Column="2" Text="Check Status" Command="{Binding WsusCheckCommand}"
                            BackgroundColor="SteelBlue" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="3" IsRunning="{Binding WsusLoading}"
                                       IsVisible="{Binding WsusLoading}" Color="SteelBlue"
                                       HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="4" Padding="14,10" StrokeShape="RoundRectangle 6" BackgroundColor="#1A1A1A" Stroke="#333">
                    <ScrollView><Label Text="{Binding WsusOutput}" FontFamily="Courier New" FontSize="12" TextColor="#00FF41"/></ScrollView>
                </Border>
            </Grid>

            <!-- â”€â”€ Disk Cleanup â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelDiskCleanup" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="8" Padding="4" IsVisible="False">
                <Label Grid.Row="0" Text="Remove temporary files from the target machine. Files newer than the selected days are kept. Requires admin rights."
                       TextColor="Gray" FontSize="12"/>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Drive:" VerticalOptions="Center" FontAttributes="Bold"/>
                    <Picker Grid.Column="1" ItemsSource="{Binding CleanupDrives}" SelectedItem="{Binding SelectedCleanupDrive}" WidthRequest="90"/>
                    <Button Grid.Column="2" Text="Load Drives" Command="{Binding LoadCleanupDrivesCommand}"
                            BackgroundColor="SteelBlue" Padding="12,6" FontSize="12"/>
                    <Label Grid.Column="3" Text="  Keep files newer than:" VerticalOptions="Center"/>
                    <Grid Grid.Column="4" ColumnDefinitions="80,*" ColumnSpacing="4">
                        <Entry Grid.Column="0" Text="{Binding CleanupDays}" Keyboard="Numeric" Placeholder="7"/>
                        <Label Grid.Column="1" Text="days" VerticalOptions="Center" TextColor="Gray"/>
                    </Grid>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16">
                    <HorizontalStackLayout Grid.Column="0" Spacing="4">
                        <CheckBox IsChecked="{Binding CleanWinTemp}"/>
                        <Label Text="Windows Temp" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Grid.Column="1" Spacing="4">
                        <CheckBox IsChecked="{Binding CleanSwDist}"/>
                        <Label Text="SoftwareDistribution" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Grid.Column="2" Spacing="4">
                        <CheckBox IsChecked="{Binding CleanUserTemp}"/>
                        <Label Text="User Temp" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Grid.Column="3" Spacing="4">
                        <CheckBox IsChecked="{Binding CleanIisLogs}"/>
                        <Label Text="IIS Logs" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Grid.Column="4" Spacing="4">
                        <CheckBox IsChecked="{Binding CleanRecycleBin}"/>
                        <Label Text="Recycle Bin" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Grid>
                <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Run Cleanup" Command="{Binding RunCleanupCommand}"
                            BackgroundColor="#8B0000" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding CleanupLoading}"
                                       IsVisible="{Binding CleanupLoading}" Color="SteelBlue"
                                       HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="4" Padding="14,10" StrokeShape="RoundRectangle 6" BackgroundColor="#1A1A1A" Stroke="#333">
                    <ScrollView><Label Text="{Binding CleanupOutput}" FontFamily="Courier New" FontSize="12" TextColor="#00FF41"/></ScrollView>
                </Border>
            </Grid>

            <!-- â”€â”€ Keep Alive â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelKeepAlive" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8" Padding="4" IsVisible="False">
                <Label Grid.Row="0" Text="Prevents this machine from sleeping or locking by telling Windows the system is in use. Useful during large downloads or remote sessions."
                       TextColor="Gray" FontSize="12"/>
                <Grid Grid.Row="1" ColumnDefinitions="80,*,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Duration (hours):" VerticalOptions="Center" FontAttributes="Bold"/>
                    <Picker Grid.Column="1" ItemsSource="{Binding KeepAliveDurationOptions}" SelectedItem="{Binding KeepAliveDurationHours}"/>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="{Binding KeepAliveButtonText}" Command="{Binding ToggleKeepAliveCommand}"
                            BackgroundColor="#228B22" Padding="16,8"/>
                    <Label Grid.Column="1" Text="{Binding KeepAliveStatus}" VerticalOptions="Center"
                           TextColor="SteelBlue" FontSize="14" FontAttributes="Bold"/>
                </Grid>
                <Border Grid.Row="3" Padding="14,10" StrokeShape="RoundRectangle 6" BackgroundColor="#1A1A1A" Stroke="#333">
                    <Label Text="Keep Alive uses the Windows SetThreadExecutionState API to prevent sleep and screen lock.&#x0a;No keystrokes are sent. Safe to use in a locked office.&#x0a;&#x0a;Status updates will appear here." FontFamily="Courier New" FontSize="12" TextColor="#888888"/>
                </Border>
            </Grid>

            <!-- â”€â”€ Hosts File Editor â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelHostsFile" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="8" Padding="4" IsVisible="False">
                <Label Grid.Row="0" Text="Edit the hosts file on the target machine via admin share (\\target\C$\...). Target must allow admin shares."
                       TextColor="Gray" FontSize="12"/>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="View Hosts File" Command="{Binding HostsViewCommand}"
                            BackgroundColor="SteelBlue" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding HostsLoading}"
                                       IsVisible="{Binding HostsLoading}" Color="SteelBlue"
                                       HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="60,120,*,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="IP Address:" VerticalOptions="Center" FontAttributes="Bold"/>
                    <Entry Grid.Column="1" Text="{Binding HostsEntryIp}" Placeholder="10.0.0.1"/>
                    <Entry Grid.Column="2" Text="{Binding HostsEntryHost}" Placeholder="hostname.domain.local"/>
                    <Button Grid.Column="3" Text="Add Entry" Command="{Binding HostsAddCommand}"
                            BackgroundColor="#228B22" Padding="16,8"/>
                </Grid>
                <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0" Text="{Binding HostsRemoveHost}" Placeholder="Hostname or IP to remove (partial match)"/>
                    <Button Grid.Column="1" Text="Remove Entry" Command="{Binding HostsRemoveCommand}"
                            BackgroundColor="#8B0000" Padding="16,8"/>
                </Grid>
                <Border Grid.Row="4" Padding="14,10" StrokeShape="RoundRectangle 6" BackgroundColor="#1A1A1A" Stroke="#333">
                    <ScrollView><Label Text="{Binding HostsOutput}" FontFamily="Courier New" FontSize="12" TextColor="#00FF41"/></ScrollView>
                </Border>
            </Grid>

            <!-- â”€â”€ Reset AD User Password â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Grid x:Name="PanelAdReset" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="8" Padding="4" IsVisible="False">
                <Label Grid.Row="0" Text="Reset an Active Directory user password. Requires ActiveDirectory module on this machine and domain connectivity."
                       TextColor="Gray" FontSize="12"/>
                <Grid Grid.Row="1" ColumnDefinitions="90,*,90,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Username:" VerticalOptions="Center" FontAttributes="Bold"/>
                    <Entry Grid.Column="1" Text="{Binding AdResetUsername}" Placeholder="SamAccountName"/>
                    <Label Grid.Column="2" Text="New Password:" VerticalOptions="Center"/>
                    <Entry Grid.Column="3" Text="{Binding AdResetPassword}" IsPassword="True"/>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="16">
                    <CheckBox Grid.Column="0" IsChecked="{Binding AdResetForceChange}"/>
                    <Label Grid.Column="1" Text="Force password change at next logon" VerticalOptions="Center"/>
                    <HorizontalStackLayout Grid.Column="2" Spacing="8">
                        <CheckBox IsChecked="{Binding AdResetUnlock}"/>
                        <Label Text="Unlock account" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Grid>
                <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Reset Password" Command="{Binding AdResetCommand}"
                            BackgroundColor="#8B0000" Padding="16,8"/>
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding AdResetLoading}"
                                       IsVisible="{Binding AdResetLoading}" Color="SteelBlue"
                                       HorizontalOptions="Start" VerticalOptions="Center"/>
                </Grid>
                <Border Grid.Row="4" Padding="14,10" StrokeShape="RoundRectangle 6" BackgroundColor="#1A1A1A" Stroke="#333">
                    <ScrollView><Label Text="{Binding AdResetOutput}" FontFamily="Courier New" FontSize="12" TextColor="#00FF41"/></ScrollView>
                </Border>
            </Grid>


            <!-- PowerCopy -->
            <Grid x:Name="PanelPowerCopy" RowDefinitions="Auto,Auto" RowSpacing="8" Padding="4" IsVisible="False">
                <Label Grid.Row="0" Text="Opens PowerCopy - a Robocopy GUI for advanced file copy, mirror, and move operations with logging and progress." TextColor="Gray" FontSize="12"/>
                <Button Grid.Row="1" Text="Launch PowerCopy" Command="{Binding LaunchPowerCopyCommand}" BackgroundColor="SteelBlue" HorizontalOptions="Start" Padding="20,10"/>
            </Grid>

            <!-- ── General / Search & Lookup ──────────────────────────────────── -->
            <Grid x:Name="PanelSearch" RowDefinitions="Auto,*" ColumnDefinitions="*,*"
                  ColumnSpacing="12" RowSpacing="12" Padding="4" IsVisible="False">
                <!-- AD Lookup -->
                <Border Grid.Row="0" Grid.Column="0" Stroke="LightGray" Padding="12">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Active Directory Lookup" FontAttributes="Bold" FontSize="15"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry x:Name="SearchAdEntry" Placeholder="Search users or computers..."/>
                            <Button Grid.Column="1" Text="Search" Command="{Binding SearchAdCommand}"
                                    CommandParameter="{Binding Text, Source={x:Reference SearchAdEntry}}" Margin="4,0,0,0"/>
                        </Grid>
                        <CollectionView ItemsSource="{Binding AdResults}" HeightRequest="180">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Padding="4,4">
                                        <Label Text="{Binding DisplayName}" FontAttributes="Bold"/>
                                        <Label Text="{Binding UserPrincipalName}" TextColor="Gray" FontSize="12"/>
                                        <Label Text="{Binding Department}" FontSize="11"/>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Label Text="File Shares" FontAttributes="Bold" FontSize="15" Margin="0,8,0,0"/>
                        <CollectionView ItemsSource="{Binding FileShares}" HeightRequest="100">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Padding="4,4">
                                        <Label Grid.Column="0" Text="{Binding Name}"/>
                                        <Button Grid.Column="1" Text="Browse" Command="{Binding BrowseShareCommand}"
                                                CommandParameter="{Binding Path}" FontSize="11" Padding="8,4"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
                <!-- Web Search -->
                <Border Grid.Row="0" Grid.Column="1" Stroke="LightGray" Padding="12">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Web Search" FontAttributes="Bold" FontSize="15"/>
                        <Entry x:Name="WebSearchEntry2" Placeholder="Search term..."/>
                        <FlexLayout Wrap="Wrap">
                            <Button Text="Google"      Command="{Binding WebSearchCommand}" CommandParameter="https://www.google.com/search?q="              Margin="4" FontSize="12"/>
                            <Button Text="Bing"        Command="{Binding WebSearchCommand}" CommandParameter="https://www.bing.com/search?q="                Margin="4" FontSize="12"/>
                            <Button Text="Wikipedia"   Command="{Binding WebSearchCommand}" CommandParameter="https://en.wikipedia.org/wiki/Special:Search?search=" Margin="4" FontSize="12"/>
                            <Button Text="Dell Support" Command="{Binding WebSearchCommand}" CommandParameter="https://www.dell.com/support/home/en-us/search/" Margin="4" FontSize="12"/>
                        </FlexLayout>
                        <Label Text="Quick Links" FontAttributes="Bold" FontSize="15" Margin="0,8,0,0"/>
                        <Button Text="Microsoft 365 Admin"   Command="{Binding OpenUrlCommand}" CommandParameter="https://admin.microsoft.com"              HorizontalOptions="Start"/>
                        <Button Text="Azure Portal"          Command="{Binding OpenUrlCommand}" CommandParameter="https://portal.azure.com"                 HorizontalOptions="Start"/>
                        <Button Text="Exchange Admin Center" Command="{Binding OpenUrlCommand}" CommandParameter="https://admin.exchange.microsoft.com"     HorizontalOptions="Start"/>
                        <Button Text="Entra ID (Azure AD)"   Command="{Binding OpenUrlCommand}" CommandParameter="https://entra.microsoft.com"              HorizontalOptions="Start"/>
                        <Button Text="Intune / Endpoint Mgr" Command="{Binding OpenUrlCommand}" CommandParameter="https://intune.microsoft.com"             HorizontalOptions="Start"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</ContentPage>
