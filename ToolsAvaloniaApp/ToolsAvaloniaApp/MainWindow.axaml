<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ToolsAvaloniaApp.ViewModels"
        x:Class="ToolsAvaloniaApp.MainWindow"
        Title="PowellTec IT Support Tools"
        Width="940" Height="680" MinWidth="700" MinHeight="520">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <DockPanel Margin="10" LastChildFill="True">

        <!-- Target / Credentials Bar -->
        <Border DockPanel.Dock="Top" BorderBrush="#0078D4" BorderThickness="2"
                CornerRadius="4" Padding="10,8" Margin="0,0,0,8" Background="#F0F7FF">
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Target Computer:" FontWeight="Bold" VerticalAlignment="Center" Width="120"/>
                    <TextBox Text="{Binding Target}" Watermark="hostname or IP  (blank = this machine)"
                             Width="300" VerticalAlignment="Center"/>
                    <TextBlock Text="Username:" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBox Text="{Binding Username}" Watermark="DOMAIN\user"
                             Width="160" VerticalAlignment="Center"/>
                    <TextBlock Text="Password:" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding Password}" PasswordChar="*"
                             Width="130" VerticalAlignment="Center"/>
                    <Button Content="Clear" Command="{Binding ClearCommand}"
                            Background="Gray" Foreground="White" Padding="10,4" VerticalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding Loading}"
                                 Width="100" Height="6" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Leave target blank to query this machine. Credentials only needed for remote connections."
                           Foreground="Gray" FontSize="11"/>
            </StackPanel>
        </Border>

        <!-- Results Panel -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#CCCCCC" BorderThickness="1"
                CornerRadius="4" Padding="6" Height="280" Margin="0,8,0,0" Background="#1E1E1E">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding Output}" FontFamily="Courier New" FontSize="12"
                           Foreground="#D4D4D4" TextWrapping="NoWrap"/>
            </ScrollViewer>
        </Border>

        <!-- Tool Tabs -->
        <TabControl>
            <TabItem Header="Installed Apps">
                <StackPanel Margin="12" Spacing="8">
                    <TextBlock Text="Lists all installed applications from the registry." Foreground="Gray" FontSize="12"/>
                    <Button Content="Load Installed Apps" Command="{Binding LoadAppsCommand}"
                            Background="#0078D4" Foreground="White" Padding="16,8" HorizontalAlignment="Left"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Services">
                <StackPanel Margin="12" Spacing="8">
                    <TextBlock Text="Lists all Windows services with status and start type." Foreground="Gray" FontSize="12"/>
                    <Button Content="Load Services" Command="{Binding LoadServicesCommand}"
                            Background="#0078D4" Foreground="White" Padding="16,8" HorizontalAlignment="Left"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Processes">
                <StackPanel Margin="12" Spacing="8">
                    <TextBlock Text="Top 50 processes by CPU usage." Foreground="Gray" FontSize="12"/>
                    <Button Content="Load Processes" Command="{Binding LoadProcessesCommand}"
                            Background="#0078D4" Foreground="White" Padding="16,8" HorizontalAlignment="Left"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Disk Space">
                <StackPanel Margin="12" Spacing="8">
                    <TextBlock Text="Shows used, free and total space for all drives." Foreground="Gray" FontSize="12"/>
                    <Button Content="Load Disk Space" Command="{Binding LoadDiskCommand}"
                            Background="#0078D4" Foreground="White" Padding="16,8" HorizontalAlignment="Left"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Security Patches">
                <StackPanel Margin="12" Spacing="8">
                    <TextBlock Text="Lists the 50 most recent Windows hotfixes installed." Foreground="Gray" FontSize="12"/>
                    <Button Content="Load Patches" Command="{Binding LoadPatchesCommand}"
                            Background="#0078D4" Foreground="White" Padding="16,8" HorizontalAlignment="Left"/>
                </StackPanel>
            </TabItem>
        </TabControl>

    </DockPanel>
</Window>