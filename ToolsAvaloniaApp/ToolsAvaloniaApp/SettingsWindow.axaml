<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ToolsAvaloniaApp.SettingsWindow"
        Title="Settings — Quick Links"
        Width="500" Height="480"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#0D1117">

  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="#8B949E"/>
      <Setter Property="FontSize"   Value="12"/>
      <Setter Property="Margin"     Value="0,0,0,3"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background"       Value="#161B22"/>
      <Setter Property="Foreground"       Value="#E6EDF3"/>
      <Setter Property="BorderBrush"      Value="#30363D"/>
      <Setter Property="BorderThickness"  Value="1"/>
      <Setter Property="CornerRadius"     Value="4"/>
      <Setter Property="Padding"          Value="8,5"/>
      <Setter Property="FontSize"         Value="13"/>
    </Style>
    <Style Selector="Button.save">
      <Setter Property="Background"   Value="#238636"/>
      <Setter Property="Foreground"   Value="White"/>
      <Setter Property="Padding"      Value="20,8"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="FontSize"     Value="13"/>
      <Setter Property="Cursor"       Value="Hand"/>
    </Style>
    <Style Selector="Button.save:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2EA043"/>
    </Style>
    <Style Selector="Button.cancel">
      <Setter Property="Background"   Value="#21262D"/>
      <Setter Property="Foreground"   Value="#E6EDF3"/>
      <Setter Property="Padding"      Value="20,8"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="FontSize"     Value="13"/>
      <Setter Property="Cursor"       Value="Hand"/>
    </Style>
  </Window.Styles>

  <DockPanel Margin="24">
    <!-- Buttons -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="10" Margin="0,16,0,0">
      <Button Classes="cancel" Content="Cancel" Click="Cancel_Click"/>
      <Button Classes="save"   Content="Save"   Click="Save_Click"/>
    </StackPanel>

    <TextBlock DockPanel.Dock="Top" Text="Quick Link Buttons"
               Foreground="#E6EDF3" FontSize="16" FontWeight="SemiBold"
               Margin="0,0,0,16"/>

    <ScrollViewer>
      <StackPanel Spacing="12" Name="LinksPanel"/>
    </ScrollViewer>
  </DockPanel>
</Window>
