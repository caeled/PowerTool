<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>SoundCombine</AssemblyName>
    <RootNamespace>SoundCombineApp</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <!-- Copy native binaries to output bin\ subfolder (regular build) -->
    <Content Include="native\sndfile-concat.exe" CopyToOutputDirectory="PreserveNewest" Link="bin\sndfile-concat.exe"/>
    <Content Include="native\libsndfile.dll"      CopyToOutputDirectory="PreserveNewest" Link="bin\libsndfile.dll"/>
    <Content Include="native\msvcp71.dll"         CopyToOutputDirectory="PreserveNewest" Link="bin\msvcp71.dll"/>
    <Content Include="native\msvcr71.dll"         CopyToOutputDirectory="PreserveNewest" Link="bin\msvcr71.dll"/>
    <Content Include="native\silence03.WAV"       CopyToOutputDirectory="PreserveNewest" Link="bin\silence03.WAV"/>
  </ItemGroup>

  <!-- Copy native binaries to publish\bin\ after publish -->
  <Target Name="CopyNativesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <NativeFiles Include="$(MSBuildProjectDirectory)\native\*"/>
    </ItemGroup>
    <Copy SourceFiles="@(NativeFiles)" DestinationFolder="$(PublishDir)bin\" SkipUnchangedFiles="true"/>
  </Target>
</Project>
