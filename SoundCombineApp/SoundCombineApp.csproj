<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>SoundCombine</AssemblyName>
    <RootNamespace>SoundCombineApp</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bundle the sndfile-concat binaries as content -->
    <Content Include="bin\sndfile-concat.exe" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="bin\libsndfile.dll"      CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="bin\msvcp71.dll"         CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="bin\msvcr71.dll"         CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="bin\silence03.WAV"       CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>
